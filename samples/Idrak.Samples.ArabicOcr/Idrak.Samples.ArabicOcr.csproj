<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reading document images into text (Arabic first, any script): an application on Idrak's public API. As an app
       references Idrak: the packages (in this repository they come from the clone itself, IdrakFromSource in
       samples/Directory.Build.props). The vision-language reader's family is the Gemma 3 plug-in and the line recognizer is
       the CRNN plug-in of Idrak.Vision.Plugins (Idrak.Vision.Plugins.Gemma, Idrak.Vision.Plugins.Crnn), both registered
       by the app itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Samples.ArabicOcr</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Text" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Vision" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Vision.Plugins" Version="$(IdrakVersion)" />
  </ItemGroup>

  <!-- The app's tests drive its commands in process. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Samples.ArabicOcr.Tests" />
  </ItemGroup>

</Project>
