<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Arabic legal documents read by vision-language models in the browser: bakrianoo's arabic-legal-documents-ocr-1.0
       (Gemma 3 4B, with its own image preprocessing), Qwen2.5-VL and our own LoRA adapters. An application on Idrak's
       public API: the packages (from this clone, IdrakFromSource in samples/Directory.Build.props) with the vision plug-ins
       package (Qwen-VL and Gemma 3), which the app registers itself. -->
  <PropertyGroup>
    <RootNamespace>Idrak.Samples.LegalOcr</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Text" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Data" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Vision.Plugins" Version="$(IdrakVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Samples.LegalOcr.Tests" />
  </ItemGroup>

</Project>
