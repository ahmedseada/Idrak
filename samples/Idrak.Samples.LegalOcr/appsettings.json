        "Preprocessing": "",
        "Prompt": "Extract details to JSON.",
        "MaxTokens": 2048,
        "MaxPixels": 1003520,
        "FullText": "full_text_extract"
      },
      {
        "Id": "qwen2.5-vl-7b",
