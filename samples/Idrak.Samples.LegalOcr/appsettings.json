        "About": "Gemma-3-4B-IT fine-tuned on scanned Arabic legal documents (its model card's preprocessing and prompt).",
        "Preprocessing": "grayscale,max_width=1024,contrast=1.5",
        "Prompt": "Extract details to JSON.",
        "MaxTokens": 2048,
        "FullText": "full_text_extract"
      },
      {
        "Id": "gemma",
        "Name": "Gemma 3 4B IT (base)",
