<Project Sdk="Microsoft.NET.Sdk">

  <!-- An app reading a scan with a Gemma 3 vision-language model: it registers the Gemma 3 vision family (the plug-in
       beside it) and uses Idrak's public API. Idrak comes as packages, from this clone in the repository (IdrakFromSource). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Nlp" Version="$(IdrakVersion)" />
    <ProjectReference Include="..\Idrak.Gemma3Vision\Idrak.Gemma3Vision.csproj" />
  </ItemGroup>

</Project>
