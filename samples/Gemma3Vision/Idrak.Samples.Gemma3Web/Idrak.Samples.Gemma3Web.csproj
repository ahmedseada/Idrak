<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A web page reading scans with a Gemma 3 vision-language model: it registers the Gemma 3 vision family (the plug-in
       beside it), loads the model once and answers uploads, streamed or not, with every figure the library gives.
       Idrak comes as packages, from this clone in the repository (IdrakFromSource). -->
  <PropertyGroup>
    <RootNamespace>Idrak.Samples.Gemma3Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Nlp" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Data" Version="$(IdrakVersion)" />
    <ProjectReference Include="..\Idrak.Gemma3Vision\Idrak.Gemma3Vision.csproj" />
  </ItemGroup>

</Project>
