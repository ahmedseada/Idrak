<Project Sdk="Microsoft.NET.Sdk">

  <!-- IdrakAudio, the from-scratch audio family as a plug-in (plan 21, S6, decision 1): a model made from a spec
       (SpeechModels.Create), trained by the library's SpeechTrainer, and read back through the speech contracts like any
       checkpoint. Load it in the command line with -P (idrak create ... -P Idrak.IdrakAudio.dll), or reference it and call
       IdrakAudioPlugin.Register() in an app. It references Idrak and Idrak.Audio as packages, as an outside plug-in does;
       in this repository they come from the clone (IdrakFromSource, samples/Directory.Build.props). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Audio" Version="$(IdrakVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Idrak.Abstraction" />
    <Using Include="Idrak.Abstraction.Devices" />
    <Using Include="Idrak.Audio.Abstractions" />
  </ItemGroup>

</Project>
