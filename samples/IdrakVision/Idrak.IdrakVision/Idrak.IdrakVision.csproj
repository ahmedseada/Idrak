<Project Sdk="Microsoft.NET.Sdk">

  <!-- IdrakVision, Idrak's own vision-language family, as a plug-in (plan 19, track B): a model of it is made from a
       description (idrak create with "vision"), pretrained (idrak pretrain) and read back like any checkpoint. Load it in
       the command line with -P (idrak -P Idrak.IdrakVision.dll create spec.json -o model), or reference it and call
       IdrakVisionPlugin.Register() in an app. It references Idrak as packages, as an outside plug-in does; in this
       repository they come from the clone (IdrakFromSource, samples/Directory.Build.props). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Imaging" Version="$(IdrakVersion)" />
  </ItemGroup>

</Project>
