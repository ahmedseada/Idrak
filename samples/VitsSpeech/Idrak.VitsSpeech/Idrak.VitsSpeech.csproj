<Project Sdk="Microsoft.NET.Sdk">

  <!-- VitsSpeech, a VITS text-to-speech family (transformers' VitsModel, as facebook/mms-tts-<lang> ships it) as a
       plug-in (plan 21, S5): one checkpoint holds the text encoder, the stochastic duration predictor, the flow and the
       HiFi-GAN decoder. Load it in the command line with -P (idrak speak ... -P Idrak.VitsSpeech.dll), or reference it
       and call VitsSpeechPlugin.Register() in an app. It references Idrak and Idrak.Audio as packages, as an outside
       plug-in does; in this repository they come from the clone (IdrakFromSource, samples/Directory.Build.props). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="$(IdrakVersion)" />
    <PackageReference Include="Idrak.Audio" Version="$(IdrakVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OpenVoice converter plug-in reuses the VITS layers (the WaveNet, the flow, the HiFi-GAN decoder). -->
    <InternalsVisibleTo Include="Idrak.OpenVoice" />
    <InternalsVisibleTo Include="Idrak.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Idrak.Abstraction" />
    <Using Include="Idrak.Abstraction.Devices" />
    <Using Include="Idrak.Audio.Abstractions" />
  </ItemGroup>

</Project>
