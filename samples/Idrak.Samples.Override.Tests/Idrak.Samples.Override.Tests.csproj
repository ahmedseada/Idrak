<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's test project: the app and the testing kit, nothing internal (as with the NuGet packages). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak.Samples.Override\Idrak.Samples.Override.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Abstraction.Testing\Idrak.Abstraction.Testing.csproj" />
  </ItemGroup>

  <!-- What once broke the app, saved by the kit (Regression.Save), replayed by the tests. -->
  <ItemGroup>
    <None Include="regressions\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="regressions" />
  </ItemGroup>

</Project>
