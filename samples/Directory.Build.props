<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Samples that reference Idrak as packages (Idrak.Samples.Override, as an app would) build against this clone unless
       IdrakFromPackages is true: dotnet build -p:IdrakFromPackages=true -p:IdrakVersion=VERSION
       -p:RestoreAdditionalProjectSources=FOLDER takes them from a folder that dotnet pack filled (see
       build/IdrakFromSource.targets). Give the feed's exact VERSION: the default floating one would prefer a release on
       nuget.org to a local prerelease. -->
  <PropertyGroup>
    <IdrakFromSource Condition="'$(IdrakFromSource)' == '' and '$(IdrakFromPackages)' != 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</IdrakFromSource>
    <IdrakVersion Condition="'$(IdrakVersion)' == ''">$(VersionPrefix)-*</IdrakVersion>
  </PropertyGroup>
</Project>
