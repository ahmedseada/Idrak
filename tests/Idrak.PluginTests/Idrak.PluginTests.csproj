<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plug-ins written the way an outside package writes them: this assembly is not among the InternalsVisibleTo
       friends of Idrak, so it compiles against their public API alone. The tests run from the
       self-contained runner in tests/Idrak.Tests (the "outside plug-in" group). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Idrak\Idrak.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Gpu\Idrak.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Text\Idrak.Text.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Vision\Idrak.Vision.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Audio\Idrak.Audio.csproj" />
    <ProjectReference Include="..\..\src\Idrak.Abstraction.Testing\Idrak.Abstraction.Testing.csproj" />
    <!-- LLaVA, the text decoder of the outside vision family (VisionFamilyPlugin.cs), comes from the plug-in package, which
         has no internals either (plan 26, P5). -->
    <ProjectReference Include="..\..\src\Idrak.Vision.Plugins\Idrak.Vision.Plugins.csproj" />
  </ItemGroup>

</Project>
