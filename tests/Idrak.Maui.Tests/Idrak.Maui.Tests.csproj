<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Idrak.Maui's tests (plan 34, M3), on the net10.0 target of Idrak.Maui (no platform: MAUI's platform services are
    given in-memory stand-ins), the CPU only. Its own runner, like the repository's other app test projects (the
    commands are in Program.cs); it also writes and checks api/Idrak.Maui.txt, which tests/Idrak.Tests cannot (it does
    not build MAUI projects).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Maui.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Idrak.Maui\Idrak.Maui.csproj" />
    <!-- The Chat lab's end-to-end test registers Qwen, as the app does (Idrak.Maui registers no family). -->
    <ProjectReference Include="..\..\src\Idrak.Text.Plugins\Idrak.Text.Plugins.csproj" />
    <!-- The Transcribe lab's end-to-end test reads the repository's tiny-whisper through the Whisper plug-in. -->
    <ProjectReference Include="..\..\src\Idrak.Audio.Plugins\Idrak.Audio.Plugins.csproj" />
    <!-- The OCR lab's end-to-end test reads the repository's tiny Gemma 3 through the Gemma 3 vision plug-in. -->
    <ProjectReference Include="..\..\src\Idrak.Vision.Plugins\Idrak.Vision.Plugins.csproj" />
  </ItemGroup>

</Project>
