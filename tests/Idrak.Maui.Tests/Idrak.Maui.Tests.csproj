<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Idrak.Maui's tests (plan 34, M3), on the net10.0 target of Idrak.Maui (no platform: MAUI's platform services are
    given in-memory stand-ins), the CPU only. Its own runner, like the repository's other app test projects (the
    commands are in Program.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Maui.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Idrak.Maui\Idrak.Maui.csproj" />
    <!-- The Terminal page's end-to-end test runs the idrak commands through the app's own runner (compiled here from the
         app's source, so it is built and run without building the app). -->
    <ProjectReference Include="..\..\src\Idrak.Cli.Commands\Idrak.Cli.Commands.csproj" />
    <Compile Include="..\..\apps\Idrak.Mobile\IdrakCommandRunner.cs" Link="App\IdrakCommandRunner.cs" />
  </ItemGroup>

</Project>
