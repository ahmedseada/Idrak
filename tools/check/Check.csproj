<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pre-build check (tools/check/README.md): every project's compilation in memory, every error at once. Roslyn 5.0,
       the compiler of the .NET 10 SDK (keep it the SDK's, so it reports what the build reports). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>idrak-check</AssemblyName>
    <RootNamespace>Idrak.Tools.Check</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild's own assemblies come from the SDK the locator finds, never from the output folder. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.31" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
  </ItemGroup>

</Project>
