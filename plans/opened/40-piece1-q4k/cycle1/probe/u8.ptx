.version 7.0
.target sm_80
.address_size 64
.visible .entry t(.param .u64 p)
{
  .reg .b32 %r<8>; .reg .f32 %f<8>; .reg .b64 %rd<4>;
  ld.param.u64 %rd1, [p];
  ld.global.u32 %r1, [%rd1];
  ld.global.f32 %f5, [%rd1+4];
  ld.global.f32 %f6, [%rd1+8];
  and.b32 %r2, %r1, 252645135;
  shr.b32 %r3, %r2, 8; cvt.rn.f32.u8 %f1, %r3; fma.rn.f32 %f2, %f1, %f5, %f6;
  st.global.f32 [%rd1+12], %f2;
  ret;
}
