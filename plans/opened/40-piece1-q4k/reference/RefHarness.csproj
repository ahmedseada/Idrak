<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adad piece 1's reference harness: runs the parts Adad copied, as the Idrak build in IdrakBin has them (loaded at run
       time, never referenced by Adad), and prints the SHA-256 of what they give, for Adad's tests to compare with (S3). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IdrakBin>D:\Projects\idrak\test-output\worktrees\adad\src\Idrak.Cli\bin\Release\net10.0</IdrakBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Idrak"><HintPath>$(IdrakBin)\Idrak.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Idrak.Abstraction"><HintPath>$(IdrakBin)\Idrak.Abstraction.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Idrak.Gpu"><HintPath>$(IdrakBin)\Idrak.Gpu.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
