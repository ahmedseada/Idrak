<Project>
  <!-- Idrak.Abstraction holds Device, Tensor and the other types nearly every program names; projects with implicit
       usings get it as a global using, so code written for Idrak 0.3 (`using Idrak;`) compiles unchanged. -->
  <ItemGroup Condition="'$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true'">
    <Using Include="Idrak.Abstraction" />
    <Using Include="Idrak.Abstraction.Data" />
    <Using Include="Idrak.Abstraction.Diagnostics" />
    <Using Include="Idrak.Abstraction.Formats" />
    <Using Include="Idrak.Abstraction.Generation" />
    <Using Include="Idrak.Abstraction.Modules" />
    <Using Include="Idrak.Abstraction.Retrieval" />
    <Using Include="Idrak.Abstraction.Serving" />
    <Using Include="Idrak.Abstraction.Training" />
  </ItemGroup>
</Project>
