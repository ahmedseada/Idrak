<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Audio.Plugins</RootNamespace>
    <AssemblyName>Idrak.Audio.Plugins</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Audio.Plugins</PackageId>
    <Description>The speech and voice model families for Idrak, as plug-ins on the library's public API (one namespace per family): reference it and call AudioPlugins.RegisterAll(), or register one family with its own Register().</Description>
  </PropertyGroup>

  <!-- Plan 26: a plug-in package uses the library's public API only; no library assembly grants it internals. -->
  <ItemGroup>
    <ProjectReference Include="..\Idrak.Audio\Idrak.Audio.csproj" />
  </ItemGroup>

</Project>
