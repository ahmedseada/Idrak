<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.FineTuning.Cli</RootNamespace>
    <AssemblyName>idrak-tune</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>idrak-tune</ToolCommandName>
    <PackageId>Idrak.FineTuning.Cli</PackageId>
    <Version>0.1.0</Version>
    <!-- A new package version on every pack (0.1.yyMMdd.HHmm, UTC), so "dotnet tool update" always installs the latest. -->
    <PackageVersion>0.1.$([System.DateTime]::UtcNow.ToString("yyMMdd")).$([System.DateTime]::UtcNow.ToString("HHmm").TrimStart("0"))</PackageVersion>
    <Description>idrak-tune: fine-tune pretrained language models (LoRA / QLoRA) on any dataset idrak-data reads, evaluate them, chat with them and export them; one tool for every fine-tuning job.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
    <ProjectReference Include="..\Idrak.Datasets\Idrak.Datasets.csproj" />
    <ProjectReference Include="..\Idrak.Pretrained\Idrak.Pretrained.csproj" />
  </ItemGroup>

</Project>
