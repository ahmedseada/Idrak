<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Text.Plugins</RootNamespace>
    <AssemblyName>Idrak.Text.Plugins</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Text.Plugins</PackageId>
    <Description>The text model families for Idrak, as plug-ins on the library's public API (one namespace per family): reference it and call TextPlugins.RegisterAll(), or register one family with its own Register().</Description>
  </PropertyGroup>

  <!-- Plan 26: a plug-in package uses the library's public API only; no library assembly grants it internals. -->
  <ItemGroup>
    <ProjectReference Include="..\Idrak.Text\Idrak.Text.csproj" />
  </ItemGroup>

  <!-- Plan 36, G1: the C# task families (CSharp/CSharpTaskFamilies.cs) read C# as Roslyn syntax trees (syntax only: no
       compilation, no semantic model). The C# plug-in alone uses it; no library package references Roslyn. Pinned to an
       exact release (5.6.0, 2026-07-02). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
