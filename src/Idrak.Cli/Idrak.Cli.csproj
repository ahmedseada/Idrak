<Project Sdk="Microsoft.NET.Sdk">

  <!--
    idrak, the tool: the commands (src/Idrak.Cli.Commands, a library any host can run them from) with this Program and
    the servers that need ASP.NET Core (serve and ui's HTTP server, the cluster dashboard), registered in CommandServers
    at startup.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Cli</RootNamespace>
    <!-- Not "idrak": assembly names ignore case, so it would clash with the Idrak library; the command stays idrak. -->
    <AssemblyName>Idrak.Cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>idrak</ToolCommandName>
    <PackageId>Idrak.Cli</PackageId>
    <Description>idrak: one command-line tool for Idrak: check devices, chat with and serve language models, manage models, benchmark, fine-tune and prepare data.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak.Cli.Commands\Idrak.Cli.Commands.csproj" />
    <!-- serve and ui: the inference engine's HTTP endpoints. -->
    <ProjectReference Include="..\Idrak.AspNetCore\Idrak.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- serve, ui and cluster ui: the web server -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- idrak cluster ui: the dashboard's page, one self-contained file served as it is (plan 23, phase C9). -->
  <ItemGroup>
    <EmbeddedResource Include="Commands\Cluster\Dashboard\dashboard.html" LogicalName="Dashboard/dashboard.html" WithCulture="false" />
  </ItemGroup>

</Project>
