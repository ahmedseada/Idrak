<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Cli</RootNamespace>
    <!-- Not "idrak": assembly names ignore case, so it would clash with the Idrak library; the command stays idrak. -->
    <AssemblyName>Idrak.Cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>idrak</ToolCommandName>
    <PackageId>Idrak.Cli</PackageId>
    <Description>idrak: one command-line tool for Idrak: check devices, chat with and serve language models, manage models, benchmark, fine-tune and prepare data.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
    <!-- idrak kernels dump writes the GPU kernel sources. -->
    <ProjectReference Include="..\Idrak.Gpu\Idrak.Gpu.csproj" />
    <ProjectReference Include="..\Idrak.Nlp\Idrak.Nlp.csproj" />
    <ProjectReference Include="..\Idrak.Data\Idrak.Data.csproj" />
    <!-- predict and train for image models: detectors, segmenters, augmentations, losses, matchers and metrics. -->
    <ProjectReference Include="..\Idrak.Vision\Idrak.Vision.csproj" />
    <ProjectReference Include="..\Idrak.Mcp\Idrak.Mcp.csproj" />
    <ProjectReference Include="..\Idrak.AspNetCore\Idrak.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- serve, ui: the web server -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- idrak new: the project templates, embedded as Templates/KIND/PATH (file names and contents carry __NAME__ and
       the other placeholders NewCommand fills in); they are not part of this project's own build. -->
  <ItemGroup>
    <Compile Remove="Templates\**" />
    <None Remove="Templates\**" />
    <EmbeddedResource Include="Templates\**\*.template" LogicalName="Templates/%(RecursiveDir)%(Filename)" WithCulture="false" />
  </ItemGroup>

</Project>
