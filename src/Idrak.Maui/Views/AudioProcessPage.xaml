<?xml version="1.0" encoding="utf-8" ?>
<!--
  The Audio process feature (plan 34, M6): the sound (record from the microphone, or pick a file), the pipeline as the
  library's text with the registered processors as chips to tap, apply, play the original and the processed (A/B), the
  pipeline's latency and delay, the time cold and warm, the levels before and after, save and share; live monitoring
  (off by default, with its feedback warning) and the lab's settings. Colours, sizes and spacing are the theme's keys only.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.AudioProcessPage"
             x:DataType="vm:AudioProcessViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <!-- The record button: a round accent button with the mark alone, red (the theme's error colour) while recording. -->
        <Style x:Key="AudioRecordButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource IdrakAccent}" />
            <Setter Property="TextColor" Value="{DynamicResource IdrakOnAccent}" />
            <Setter Property="BorderColor" Value="{DynamicResource IdrakCardStroke}" />
            <Setter Property="BorderWidth" Value="4" />
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="80" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAutoScalingEnabled" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{DynamicResource IdrakPagePadding}" Spacing="{DynamicResource IdrakSpacingSmall}">
            <Label Text="Audio process" Style="{DynamicResource IdrakTitle}" />
            <Label Text="A sound through the library's processors, heard before and after." Style="{DynamicResource IdrakCaption}" />

            <!-- The sound. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacing}">
                    <Label Text="Sound" Style="{DynamicResource IdrakHeading}" />
                    <Button Text="{Binding RecordGlyph}" Command="{Binding RecordCommand}" Style="{StaticResource AudioRecordButton}"
                            SemanticProperties.Description="{Binding RecordText}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource IdrakError}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Text="{Binding RecordText}" HorizontalOptions="Center" Style="{DynamicResource IdrakCaption}" />
                    <ProgressBar Progress="{Binding Level}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <Label Text="{Binding ElapsedText}" Style="{DynamicResource IdrakHeading}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding LevelText}" Style="{DynamicResource IdrakCaption}" VerticalOptions="Center" />
                    </Grid>
                    <Button Text="Pick a sound file" Command="{Binding PickFileCommand}" IsEnabled="{Binding IsIdle}" Style="{DynamicResource IdrakSecondaryButton}" />
                    <Label Text="{Binding OriginalText}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="{Binding BeforeText}" Style="{DynamicResource IdrakCaption}" />
                    <Button Text="Allow the microphone" Command="{Binding OpenPermissionSettingsCommand}" IsVisible="{Binding IsPermissionRefused}"
                            Style="{DynamicResource IdrakSecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- The pipeline: its text, checked as it is written, and the processors to tap. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Pipeline" Style="{DynamicResource IdrakHeading}" />
                    <Editor Text="{Binding PipelineText}" Placeholder="highpass=80, denoise=1.5, normalize=-20" AutoSize="TextChanges"
                            IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                    <Label Text="{Binding PipelineCheck}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding PipelineError}" IsVisible="{Binding HasPipelineError}" Style="{DynamicResource IdrakErrorText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <Button Text="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="1" Text="Clear" Command="{Binding ClearPipelineCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Label Text="Processors: tap one to add its step" Style="{DynamicResource IdrakCaption}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Processors}" Wrap="Wrap" Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessorChip">
                                <Button Text="{Binding Name}" Command="{Binding AddCommand}" Style="{DynamicResource IdrakChip}"
                                        ToolTipProperties.Text="{Binding Summary}" SemanticProperties.Description="{Binding Summary}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="What each processor takes" Style="{DynamicResource IdrakCaption}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Processors}" Spacing="{DynamicResource IdrakSpacingSmall}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessorChip">
                                <VerticalStackLayout>
                                    <Label Style="{DynamicResource IdrakValue}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" FontAttributes="Bold" />
                                                <Span Text="  " />
                                                <Span Text="{Binding Label}" />
                                                <Span Text="  " />
                                                <Span Text="{Binding LiveText}" TextColor="{DynamicResource IdrakTextMuted}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                                    <Label Text="{Binding ParametersText}" Style="{DynamicResource IdrakCaption}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- The result: A/B, latency and delay, cold and warm, the levels, save and share. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Before and after" Style="{DynamicResource IdrakHeading}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource IdrakSpacingSmall}">
                        <Button Text="Play original" Command="{Binding PlayOriginalCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="1" Text="Play processed" Command="{Binding PlayProcessedCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="2" Text="Stop" Command="{Binding StopCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Label Text="{Binding PlayingText}" Style="{DynamicResource IdrakHighlightText}" />
                    <Label Text="{Binding ProcessedText}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="{Binding AfterText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding LatencyText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ColdText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding WarmText}" Style="{DynamicResource IdrakCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource IdrakSpacingSmall}">
                        <Button Text="Save" Command="{Binding SaveCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="1" Text="Share" Command="{Binding ShareCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Label Text="{Binding SavedText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{DynamicResource IdrakHighlightText}" />
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Live monitoring: off until asked, with its warning. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Monitor" Style="{DynamicResource IdrakHeading}" />
                    <Label Text="{Binding MonitorWarning}" Style="{DynamicResource IdrakHighlightText}" />
                    <Button Text="{Binding MonitorButtonText}" Command="{Binding MonitorCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    <Label Text="{Binding MonitorText}" Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- The lab's settings. -->
            <Button Text="{Binding SettingsButtonText}" Command="{Binding ToggleSettingsCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
            <Label Text="{Binding SettingsMessage}" IsVisible="{Binding HasSettingsMessage}" Style="{DynamicResource IdrakHighlightText}" />
            <VerticalStackLayout IsVisible="{Binding ShowSettings}" Spacing="{DynamicResource IdrakSpacingSmall}">
                <Label Text="Kept between runs. An empty field is the default, shown in it." Style="{DynamicResource IdrakCaption}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabSettingEntry">
                            <Border Style="{DynamicResource IdrakCard}">
                                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                                    <Label Text="{Binding Title}" Style="{DynamicResource IdrakHeading}" />
                                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                                    <Entry Text="{Binding Text}" Placeholder="{Binding Placeholder}" Keyboard="{Binding Keyboard}" IsVisible="{Binding IsEntry}"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ClearButtonVisibility="WhileEditing" />
                                    <Picker ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" Title="{Binding Title}" />
                                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Keep these settings" Command="{Binding ApplySettingsCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
