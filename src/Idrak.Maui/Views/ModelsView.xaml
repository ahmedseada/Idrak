<?xml version="1.0" encoding="utf-8" ?>
<!--
  Models (plan 34, phase R): pull a Hugging Face model with its progress (a ring and a bar, the amounts, the rate, the time
  left), the suggestions to tap, the storage, and the models kept, each with its size, state and remove. Theme keys only.
-->
<ctl:AdaptiveView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
                  xmlns:ctl="clr-namespace:Idrak.Maui.Controls"
                  x:Class="Idrak.Maui.Views.ModelsView"
                  x:DataType="vm:ModelsViewModel">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <CollectionView x:Name="List" ItemsSource="{Binding Models}" SelectionMode="None" Margin="{DynamicResource IdrakPagePadding}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacing}" Padding="{DynamicResource IdrakSectionPadding}">
                    <VerticalStackLayout>
                        <Label Text="Models" Style="{DynamicResource IdrakTitle}" />
                        <Label Text="{Binding Folder, StringFormat='Kept in {0}'}" Style="{DynamicResource IdrakMicro}" LineBreakMode="MiddleTruncation" />
                    </VerticalStackLayout>

                    <!-- Pull. -->
                    <Border Style="{DynamicResource IdrakPanel}">
                        <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingChip}">
                            <Label Text="Pull a model" Style="{DynamicResource IdrakHeading}" />
                            <Label Text="A Hugging Face id, or an id and a .gguf file in it" Style="{DynamicResource IdrakCaption}" />
                            <Border Style="{DynamicResource IdrakSearchBox}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacingTile}">
                                    <ctl:IconView Glyph="down" Size="17" Stroke="{DynamicResource IdrakTextFaint}" />
                                    <Entry Grid.Column="1" Text="{Binding ModelId}" Placeholder="owner/name or owner/name/file.gguf" Keyboard="Plain" VerticalOptions="Center"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding PullCommand}" />
                                </Grid>
                            </Border>
                            <Entry Text="{Binding Revision}" Placeholder="revision: main" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                   ClearButtonVisibility="WhileEditing" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}" Wrap="Wrap" Direction="Row">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuggestionChip">
                                        <Button Text="{Binding Model}" Command="{Binding Command}" Style="{DynamicResource IdrakChip}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label Text="{Binding TokenText}" Style="{DynamicResource IdrakMicro}" />
                            <HorizontalStackLayout Spacing="{DynamicResource IdrakSpacingChip}">
                                <Button Text="Pull" Command="{Binding PullCommand}" Style="{DynamicResource IdrakGradientButton}" />
                                <Button Text="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsPulling}" Style="{DynamicResource IdrakGhostButton}" />
                            </HorizontalStackLayout>

                            <!-- The pull: a ring and a bar, the amounts, the rate and the time left (the "maui" reporter, once a progress interval). -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacing}" IsVisible="{Binding HasPull}">
                                <ctl:ProgressRing Progress="{Binding Pull.Fraction}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource IdrakSpacingTiny}" VerticalOptions="Center">
                                    <Label Text="{Binding Pull.Label}" Style="{DynamicResource IdrakItemTitle}" />
                                    <ctl:MeterBar Progress="{Binding Pull.Fraction}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource IdrakSpacingChip}">
                                        <Label Text="{Binding Pull.AmountText}" Style="{DynamicResource IdrakMeta}" />
                                        <Label Grid.Column="1" Text="{Binding Pull.RateText}" Style="{DynamicResource IdrakMeta}" />
                                        <Label Grid.Column="2" Text="{Binding Pull.TimeLeftText}" Style="{DynamicResource IdrakMeta}" />
                                    </Grid>
                                    <Label Text="{Binding Pull.Message}" Style="{DynamicResource IdrakMicro}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{DynamicResource IdrakHighlightText}" />
                            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Storage. -->
                    <Border Style="{DynamicResource IdrakPanel}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                            <ctl:IconBadge Glyph="db" Tone="Neutral" BadgeSize="38" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding StorageText}" Style="{DynamicResource IdrakValue}" />
                                <Label Text="{Binding ModelsText}" Style="{DynamicResource IdrakMicro}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Label Text="Kept here" Style="{DynamicResource IdrakSectionLabel}" />
                    <!-- In the header, not the list's EmptyView: on Windows an empty list's EmptyView covers its header and takes its clicks. -->
                    <Label Text="No models pulled yet: pull one above." IsVisible="{Binding HasNoModels}" Style="{DynamicResource IdrakCaption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelEntry">
                    <Border Style="{DynamicResource IdrakCard}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                            <Border Style="{DynamicResource IdrakAvatar}" VerticalOptions="Start">
                                <Label Text="{Binding Initial}" Style="{DynamicResource IdrakAvatarLetter}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource IdrakSpacingTiny}">
                                <Label Text="{Binding Name}" Style="{DynamicResource IdrakItemTitle}" />
                                <Label Text="{Binding Owner}" Style="{DynamicResource IdrakMicro}" TextColor="{DynamicResource IdrakTextMuted}" />
                                <Label Text="{Binding StateText}" IsVisible="{Binding IsComplete}" Style="{DynamicResource IdrakSuccessText}" />
                                <Label Text="{Binding StateText}" IsVisible="{Binding IsUnfinished}" Style="{DynamicResource IdrakPlannedText}" />
                                <Label Text="{Binding FilesText}" Style="{DynamicResource IdrakMicro}" />
                                <Label Text="{Binding Modified}" Style="{DynamicResource IdrakMicro}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="{DynamicResource IdrakSpacingChip}" HorizontalOptions="End">
                                <Label Text="{Binding SizeText}" Style="{DynamicResource IdrakMeta}" HorizontalOptions="End" />
                                <Border Style="{DynamicResource IdrakIconButton}" SemanticProperties.Description="Remove">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RemoveCommand}" />
                                    </Border.GestureRecognizers>
                                    <ctl:IconView Glyph="trash" Size="18" Stroke="{DynamicResource IdrakError}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ctl:AdaptiveView>
