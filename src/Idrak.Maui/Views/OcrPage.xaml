<?xml version="1.0" encoding="utf-8" ?>
<!--
  The OCR feature (plan 34, M6): a vision-language model of the store (its device, formats, load time and what it was
  measured to need), a photo from the camera or the gallery, the preprocessing pipeline and the page as the model sees
  it, Read and Stop with the answer streaming and its tokens per second (cold and warm apart), copy and share, and the
  lab's settings. Colours, sizes and spacing are the theme's keys only.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.OcrPage"
             x:DataType="vm:OcrViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- The page's picture: the whole of it in the card's width, on the page's ground. -->
        <Style x:Key="OcrPicture" TargetType="Image">
            <Setter Property="Aspect" Value="AspectFit" />
            <Setter Property="BackgroundColor" Value="{DynamicResource IdrakPageBackground}" />
            <Setter Property="MaximumHeightRequest" Value="420" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{DynamicResource IdrakPagePadding}" Spacing="{DynamicResource IdrakSpacingSmall}">
            <Label Text="OCR" Style="{DynamicResource IdrakTitle}" />
            <Label Text="A page read by a vision-language model on this phone: the photo decoded by the library's own codecs, the answer as it is written."
                   Style="{DynamicResource IdrakCaption}" />

            <!-- The reader. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Reader" Style="{DynamicResource IdrakHeading}" />
                    <Picker Title="Vision-language model" ItemsSource="{Binding VisionModels}" SelectedItem="{Binding SelectedModel}" IsVisible="{Binding HasVisionModels}"
                            IsEnabled="{Binding IsIdle}" />
                    <Label Text="{Binding SelectedModel.Details}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ModelStatus}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ModelsText}" Style="{DynamicResource IdrakCaption}" />
                    <Button Text="Go to Models" Command="{Binding GoToModelsCommand}" IsVisible="{Binding HasNoVisionModels}" Style="{DynamicResource IdrakSecondaryButton}" />
                    <Label Text="{Binding ColdText}" IsVisible="{Binding HasCold}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding WarmText}" IsVisible="{Binding HasWarm}" Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- The page: the photo, the pipeline, the page as the model sees it. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Page" Style="{DynamicResource IdrakHeading}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <Button Text="Take a photo" Command="{Binding TakePhotoCommand}" IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="1" Text="From the gallery" Command="{Binding PickPhotoCommand}" IsEnabled="{Binding IsIdle}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Button Text="Allow the camera" Command="{Binding OpenPermissionSettingsCommand}" IsVisible="{Binding IsPermissionRefused}" Style="{DynamicResource IdrakSecondaryButton}" />
                    <Label Text="{Binding Formats}" IsVisible="{Binding HasNoPage}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding PhotoText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="Preprocessing (optional): image transforms run before the model's own processor." Style="{DynamicResource IdrakCaption}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <Entry Text="{Binding Pipeline}" Placeholder="grayscale,max_width=1024,contrast=1.5" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                               ClearButtonVisibility="WhileEditing" />
                        <Button Grid.Column="1" Text="Prepare" Command="{Binding PrepareCommand}" IsEnabled="{Binding IsIdle}" Style="{DynamicResource IdrakSecondaryButton}" VerticalOptions="Center" />
                    </Grid>
                    <Image Source="{Binding PageSource}" IsVisible="{Binding HasPage}" Style="{StaticResource OcrPicture}" SemanticProperties.Description="The page as the model sees it" />
                    <Label Text="{Binding PageText}" Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- The read. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Text" Style="{DynamicResource IdrakHeading}" />
                    <Label Text="{Binding Prompt, StringFormat='Instruction: {0}'}" Style="{DynamicResource IdrakCaption}" />
                    <Button Text="Read" Command="{Binding ReadCommand}" IsVisible="{Binding IsNotReading}" IsEnabled="{Binding IsIdle}" />
                    <Button Text="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsReading}" Style="{DynamicResource IdrakDangerButton}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                    <Label Text="{Binding LiveText}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{DynamicResource IdrakHighlightText}" />
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                    <Label Text="{Binding Text}" IsVisible="{Binding HasText}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="Nothing read yet." IsVisible="{Binding HasNoText}" Style="{DynamicResource IdrakCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <Button Text="Copy" Command="{Binding CopyCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="1" Text="Share" Command="{Binding ShareCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The lab's settings. -->
            <Button Text="{Binding SettingsButtonText}" Command="{Binding ToggleSettingsCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
            <Label Text="{Binding SettingsMessage}" IsVisible="{Binding HasSettingsMessage}" Style="{DynamicResource IdrakHighlightText}" />
            <VerticalStackLayout IsVisible="{Binding ShowSettings}" Spacing="{DynamicResource IdrakSpacingSmall}">
                <Label Text="Kept between runs. An empty field is the library's default, shown in it." Style="{DynamicResource IdrakCaption}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabSettingEntry">
                            <Border Style="{DynamicResource IdrakCard}">
                                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                                    <Label Text="{Binding Title}" Style="{DynamicResource IdrakHeading}" />
                                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                                    <Entry Text="{Binding Text}" Placeholder="{Binding Placeholder}" Keyboard="{Binding Keyboard}" IsVisible="{Binding IsEntry}"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ClearButtonVisibility="WhileEditing" />
                                    <Picker ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" Title="{Binding Title}" />
                                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Keep these settings" Command="{Binding ApplySettingsCommand}" Margin="0,0,0,24" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
