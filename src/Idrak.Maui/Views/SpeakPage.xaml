<?xml version="1.0" encoding="utf-8" ?>
<!--
  The Speak feature (plan 34, M6): a synthesis model from the store (one that cannot speak here listed with its reason),
  its voices, the text, the speak button (stop while it speaks), how far the speech is, the time to the first sound and
  the real-time factor cold and warm apart, the speech kept to play again, save and share, and the lab's settings (every
  synthesis option, the speaker, how the speech is saved). Colours, sizes and spacing are the theme's keys only.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.SpeakPage"
             x:DataType="vm:SpeakViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- The speak button: a round accent button with the mark alone, red (the theme's error colour) while speaking. -->
        <Style x:Key="SpeakButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource IdrakAccent}" />
            <Setter Property="TextColor" Value="{DynamicResource IdrakOnAccent}" />
            <Setter Property="BorderColor" Value="{DynamicResource IdrakCardStroke}" />
            <Setter Property="BorderWidth" Value="4" />
            <Setter Property="WidthRequest" Value="96" />
            <Setter Property="HeightRequest" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontAutoScalingEnabled" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{DynamicResource IdrakPagePadding}" Spacing="{DynamicResource IdrakSpacingSmall}">
            <Label Text="Speak" Style="{DynamicResource IdrakTitle}" />
            <Label Text="Text read aloud on this phone: each sentence plays as soon as it is made, the next made while it plays."
                   Style="{DynamicResource IdrakCaption}" />

            <!-- The model and the voice. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Synthesis model" Style="{DynamicResource IdrakHeading}" />
                    <Picker Title="Synthesis model" ItemsSource="{Binding SynthesisModels}" SelectedItem="{Binding SelectedModel}" IsVisible="{Binding HasModels}" />
                    <Label Text="{Binding SelectedModel.Details}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ModelReason}" IsVisible="{Binding HasModelReason}" Style="{DynamicResource IdrakErrorText}" />
                    <Label Text="{Binding ModelStatus}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="{Binding ModelsText}" Style="{DynamicResource IdrakCaption}" />
                    <Button Text="Go to Models" Command="{Binding GoToModelsCommand}" IsVisible="{Binding HasNoModels}" Style="{DynamicResource IdrakSecondaryButton}" />

                    <!-- Loading the model: the item the "maui" reporter updates at most once a progress interval. -->
                    <VerticalStackLayout IsVisible="{Binding HasWork}" Spacing="{DynamicResource IdrakSpacingSmall}">
                        <Label Text="{Binding Work.Label}" Style="{DynamicResource IdrakCaption}" />
                        <ProgressBar Progress="{Binding Work.Fraction}" />
                        <Label Text="{Binding Work.Message}" Style="{DynamicResource IdrakCaption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasVoices}" Spacing="{DynamicResource IdrakSpacingSmall}">
                        <Label Text="Voice" Style="{DynamicResource IdrakHeading}" />
                        <Picker Title="Voice" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" />
                        <Label Text="{Binding SelectedVoice.Details}" Style="{DynamicResource IdrakCaption}" />
                        <Label Text="{Binding VoiceReason}" IsVisible="{Binding HasVoiceReason}" Style="{DynamicResource IdrakErrorText}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- The text and the speak button. -->
            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacing}">
                    <Editor Text="{Binding Text}" Placeholder="The text to speak" AutoSize="TextChanges" IsEnabled="{Binding IsIdle}" />
                    <Button Text="{Binding SpeakGlyph}" Command="{Binding SpeakCommand}" Style="{StaticResource SpeakButton}"
                            SemanticProperties.Description="{Binding SpeakText}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSpeaking}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource IdrakError}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Text="{Binding SpeakText}" HorizontalOptions="Center" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ProgressLine}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{DynamicResource IdrakHighlightText}" />
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                </VerticalStackLayout>
            </Border>

            <!-- The measures: cold (the first speech after a load) apart from warm. -->
            <Border Style="{DynamicResource IdrakCard}" IsVisible="{Binding HasCold}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Speed" Style="{DynamicResource IdrakHeading}" />
                    <Label Text="{Binding ColdText}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="{Binding WarmText}" IsVisible="{Binding HasWarm}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="The real-time factor is the synthesis' own time over the sound's: under 1 is faster than the speech plays."
                           Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- The speech kept. -->
            <Border Style="{DynamicResource IdrakCard}" IsVisible="{Binding HasSpeech}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="Speech" Style="{DynamicResource IdrakHeading}" />
                    <Label Text="{Binding SpeechText}" Style="{DynamicResource IdrakCaption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource IdrakSpacingSmall}">
                        <Button Text="Play again" Command="{Binding PlayAgainCommand}" IsEnabled="{Binding IsIdle}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="1" Text="Stop" Command="{Binding StopCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource IdrakSpacingSmall}">
                        <Button Text="Save WAV" Command="{Binding SaveWavCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="1" Text="Save MP3" Command="{Binding SaveMp3Command}" IsVisible="{Binding CanSaveMp3}" Style="{DynamicResource IdrakSecondaryButton}" />
                        <Button Grid.Column="2" Text="Share" Command="{Binding ShareCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
                    </Grid>
                    <Label Text="{Binding SavedText}" Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
            </Border>

            <!-- The lab's settings. -->
            <Button Text="{Binding SettingsButtonText}" Command="{Binding ToggleSettingsCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
            <Label Text="{Binding SettingsMessage}" IsVisible="{Binding HasSettingsMessage}" Style="{DynamicResource IdrakHighlightText}" />
            <VerticalStackLayout IsVisible="{Binding ShowSettings}" Spacing="{DynamicResource IdrakSpacingSmall}">
                <Label Text="Kept between runs. An empty field is the library's default, shown in it." Style="{DynamicResource IdrakCaption}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Settings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabSettingEntry">
                            <Border Style="{DynamicResource IdrakCard}">
                                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                                    <Label Text="{Binding Title}" Style="{DynamicResource IdrakHeading}" />
                                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                                    <Entry Text="{Binding Text}" Placeholder="{Binding Placeholder}" Keyboard="{Binding Keyboard}" IsVisible="{Binding IsEntry}"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ClearButtonVisibility="WhileEditing" />
                                    <Picker ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" Title="{Binding Title}" />
                                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Keep these settings" Command="{Binding ApplySettingsCommand}" Style="{DynamicResource IdrakSecondaryButton}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
