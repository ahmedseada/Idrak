<?xml version="1.0" encoding="utf-8" ?>
<!--
  Settings (plan 34, phase R): every option of IdrakMauiOptions by group, each with the control its value takes: segments
  for a choice of a few, a picker for many and for the device, a slider for a number with a range (and a reset to the
  default), a field for the rest (the token hidden); the labs shown as switches; storage; the app's restart; save and
  forget. An empty value is the library's own (what it measures). A setting is made with its own control only (a template
  for each kind), and the search at the top shows only the settings it finds, with their groups' headings: it changes what
  is visible, never makes a view again. A saved change that waits for the next start is marked, and the restart offered.
  Theme keys only.
-->
<ctl:AdaptiveView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
                  xmlns:views="clr-namespace:Idrak.Maui.Views"
                  xmlns:ctl="clr-namespace:Idrak.Maui.Controls"
                  x:Class="Idrak.Maui.Views.SettingsView"
                  x:DataType="vm:SettingsViewModel">
    <ctl:AdaptiveView.Resources>
        <!-- A choice of a few: segments. -->
        <DataTemplate x:Key="SegmentsSetting" x:DataType="vm:SettingEntry">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}" IsVisible="{Binding IsShown}">
                <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Segments}" Wrap="Wrap" Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceChip">
                            <Border Style="{DynamicResource IdrakChipBorder}" Margin="{DynamicResource IdrakChipMargin}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource IdrakBrushPill}" />
                                        <Setter Property="Stroke" Value="{DynamicResource IdrakSelectedStroke}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" Style="{DynamicResource IdrakChipLabel}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="Saved: it takes effect when the app starts again." IsVisible="{Binding WaitsForRestart}" Style="{DynamicResource IdrakHighlightText}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- A choice of many, or the device: a picker. -->
        <DataTemplate x:Key="PickerSetting" x:DataType="vm:SettingEntry">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}" IsVisible="{Binding IsShown}">
                <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                <Picker ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Title="{Binding Title}" />
                <Label Text="Saved: it takes effect when the app starts again." IsVisible="{Binding WaitsForRestart}" Style="{DynamicResource IdrakHighlightText}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- A number with a range: a slider, its value and a reset. -->
        <DataTemplate x:Key="SliderSetting" x:DataType="vm:SettingEntry">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}" IsVisible="{Binding IsShown}">
                <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource IdrakSpacingChip}">
                    <Slider Maximum="{Binding Maximum}" Minimum="{Binding Minimum}" Value="{Binding Number}" />
                    <Label Grid.Column="1" Text="{Binding NumberText}" Style="{DynamicResource IdrakMeta}" />
                    <Label Grid.Column="2" Text="Default" Style="{DynamicResource IdrakLink}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="Saved: it takes effect when the app starts again." IsVisible="{Binding WaitsForRestart}" Style="{DynamicResource IdrakHighlightText}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- The rest: a field (the token hidden). -->
        <DataTemplate x:Key="FieldSetting" x:DataType="vm:SettingEntry">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}" IsVisible="{Binding IsShown}">
                <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                <Entry Text="{Binding Text}" Placeholder="{Binding Placeholder}" IsPassword="{Binding IsPassword}" Keyboard="{Binding Keyboard}" ClearButtonVisibility="WhileEditing" />
                <Label Text="Saved: it takes effect when the app starts again." IsVisible="{Binding WaitsForRestart}" Style="{DynamicResource IdrakHighlightText}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
            </VerticalStackLayout>
        </DataTemplate>

        <views:SettingTemplates x:Key="SettingTemplates" Segments="{StaticResource SegmentsSetting}" Picker="{StaticResource PickerSetting}"
                                Slider="{StaticResource SliderSetting}" Field="{StaticResource FieldSetting}" />
    </ctl:AdaptiveView.Resources>

    <ScrollView>
        <VerticalStackLayout x:Name="Page" Padding="{DynamicResource IdrakPagePadding}" Spacing="{DynamicResource IdrakSpacing}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                <VerticalStackLayout>
                    <Label Text="Settings" Style="{DynamicResource IdrakTitle}" />
                    <Label Text="Kept between runs and applied at start-up. An empty value is the library's own (what it measures)." Style="{DynamicResource IdrakCaption}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" Style="{DynamicResource IdrakGradientButton}" VerticalOptions="Center" />
            </Grid>

            <!-- The search: only the settings it finds show, with their groups' headings. -->
            <Border Style="{DynamicResource IdrakSearchBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacingTile}">
                    <ctl:IconView Glyph="search" Size="17" Stroke="{DynamicResource IdrakTextFaint}" />
                    <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Find a setting: a name, a word of its help or a value" ClearButtonVisibility="WhileEditing"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" Style="{DynamicResource IdrakHighlightText}" />
            <Button Text="Restart now" Command="{Binding RestartCommand}" IsVisible="{Binding IsRestartPending}" Style="{DynamicResource IdrakSecondaryButton}"
                    HorizontalOptions="Start" />
            <Label Text="No setting matches" IsVisible="{Binding HasNoMatch}" Style="{DynamicResource IdrakCaption}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="{DynamicResource IdrakSpacing}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingGroup">
                        <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingChip}" IsVisible="{Binding IsShown}">
                            <Label Text="{Binding Title}" Style="{DynamicResource IdrakSectionLabel}" />
                            <Border Style="{DynamicResource IdrakPanel}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" BindableLayout.ItemTemplateSelector="{StaticResource SettingTemplates}"
                                                     Spacing="{DynamicResource IdrakSpacing}" />
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- The labs shown. -->
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingChip}" IsVisible="{Binding ShowFeatures}">
                <Label Text="Labs shown" Style="{DynamicResource IdrakSectionLabel}" />
                <Border Style="{DynamicResource IdrakPanel}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Features}" Spacing="{DynamicResource IdrakSpacing}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FeatureToggle">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}" IsVisible="{Binding IsShown}">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                                        <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Storage. -->
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingChip}" IsVisible="{Binding ShowStorage}">
                <Label Text="Storage in effect" Style="{DynamicResource IdrakSectionLabel}" />
                <Border Style="{DynamicResource IdrakPanel}">
                    <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                        <Label Text="The cache folder in effect" Style="{DynamicResource IdrakCaption}" />
                        <Label Text="{Binding CacheFolder}" Style="{DynamicResource IdrakMono}" />
                        <Label Text="The app's storage" Style="{DynamicResource IdrakCaption}" />
                        <Label Text="{Binding AppStorage}" Style="{DynamicResource IdrakMono}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- The app: restart it (the library, its devices and the models load afresh). -->
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingChip}" IsVisible="{Binding ShowApp}">
                <Label Text="App" Style="{DynamicResource IdrakSectionLabel}" />
                <Border Style="{DynamicResource IdrakPanel}">
                    <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                        <Label Text="Restart the app" Style="{DynamicResource IdrakItemTitle}" />
                        <Label Text="{Binding RestartText}" Style="{DynamicResource IdrakCaption}" />
                        <Button Text="Restart app" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestart}" Style="{DynamicResource IdrakGhostButton}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="{DynamicResource IdrakSpacingChip}" Margin="{DynamicResource IdrakBottomGap}">
                <Button Text="Save" Command="{Binding SaveCommand}" Style="{DynamicResource IdrakGradientButton}" />
                <Button Text="Forget the saved settings" Command="{Binding ResetCommand}" Style="{DynamicResource IdrakGhostButton}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ctl:AdaptiveView>
