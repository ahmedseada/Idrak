<?xml version="1.0" encoding="utf-8" ?>
<!--
  All labs (plan 34, phase R; apps/Idrak.Mobile/Design/shell.html and t-shell.html): every lab grouped by Language, Voice,
  Vision and this device's own, the planned ones with the amber "● Planned" and a dashed edge; a search; on a wide window a
  column a group with each lab's summary, and filters by state and by what a lab needs. Theme keys only.
-->
<ctl:AdaptiveView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
                  xmlns:ctl="clr-namespace:Idrak.Maui.Controls"
                  x:Class="Idrak.Maui.Views.LabsView"
                  x:DataType="vm:LabsViewModel">
    <ctl:AdaptiveView.Resources>
        <!-- A lab on a phone: its badge, its title, a few words or "● Planned". -->
        <DataTemplate x:Key="NarrowLab" x:DataType="vm:LabEntry">
            <ContentView Padding="{DynamicResource IdrakLabCellPadding}">
                <Border Style="{DynamicResource IdrakLabCard}" SemanticProperties.Description="{Binding Title}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPlanned}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource IdrakPlannedStroke}" />
                            <Setter Property="StrokeDashArray" Value="4,3" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacingTile}">
                        <ctl:IconBadge Glyph="{Binding Icon}" Tone="{Binding Tone}" BadgeSize="36" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{DynamicResource IdrakItemTitle}" />
                            <Label Text="{Binding Tagline}" IsVisible="{Binding IsReady}" Style="{DynamicResource IdrakMicro}" TextColor="{DynamicResource IdrakTextMuted}" />
                            <Label Text="{Binding StateText}" IsVisible="{Binding IsPlanned}" Style="{DynamicResource IdrakPlannedText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </ContentView>
        </DataTemplate>

        <!-- A lab on a wide window: its badge and state, what it does, what it needs, Open. -->
        <DataTemplate x:Key="WideLab" x:DataType="vm:LabEntry">
            <Border Style="{DynamicResource IdrakPanel}" Margin="{DynamicResource IdrakCardMargin}" SemanticProperties.Description="{Binding Title}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPlanned}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource IdrakPlannedStroke}" />
                        <Setter Property="StrokeDashArray" Value="4,3" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingTile}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                        <ctl:IconBadge Glyph="{Binding Icon}" Tone="{Binding Tone}" BadgeSize="42" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{DynamicResource IdrakHeading}" />
                            <Label Text="{Binding StateText}" Style="{DynamicResource IdrakSuccessText}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPlanned}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource IdrakPlannedText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacingChip}">
                        <Label Text="{Binding Detail}" Style="{DynamicResource IdrakMeta}" LineBreakMode="TailTruncation" />
                        <Border Grid.Column="1" Style="{DynamicResource IdrakOpenPill}" IsVisible="{Binding IsReady}">
                            <HorizontalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                                <Label Text="Open" Style="{DynamicResource IdrakChipLabel}" />
                                <ctl:IconView Glyph="arrow" Size="14" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ctl:AdaptiveView.Resources>

    <ScrollView>
        <VerticalStackLayout x:Name="Page" Padding="{DynamicResource IdrakNoInset}" Spacing="{DynamicResource IdrakSpacing}">
            <!-- The title, the counts and the search. -->
            <Grid x:Name="Header" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}" RowSpacing="{DynamicResource IdrakSpacing}">
                <HorizontalStackLayout x:Name="TitleRow" Spacing="{DynamicResource IdrakSpacingSection}">
                    <Label x:Name="TitleLabel" Text="All labs" Style="{DynamicResource IdrakSheetTitle}" VerticalOptions="Center" />
                    <Label x:Name="WideCounts" Text="{Binding LongCountsText}" Style="{DynamicResource IdrakCaption}" VerticalOptions="Center" IsVisible="False" />
                </HorizontalStackLayout>
                <Label x:Name="NarrowCounts" Grid.Column="1" Text="{Binding CountsText}" Style="{DynamicResource IdrakCaption}" VerticalOptions="Center" />
                <Border x:Name="Search" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource IdrakSearchBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacingTile}">
                        <ctl:IconView Glyph="search" Size="17" Stroke="{DynamicResource IdrakTextFaint}" />
                        <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Find a lab, a model or a setting" ClearButtonVisibility="WhileEditing"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- The filters (a wide window). -->
            <FlexLayout x:Name="FilterRow" BindableLayout.ItemsSource="{Binding Filters}" Wrap="Wrap" Direction="Row" IsVisible="False">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterChip">
                        <Border Style="{DynamicResource IdrakChipBorder}" Margin="{DynamicResource IdrakChipMargin}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource IdrakBrushPill}" />
                                    <Setter Property="Stroke" Value="{DynamicResource IdrakSelectedStroke}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Title}" Style="{DynamicResource IdrakChipLabel}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="Nothing matches: try another word." IsVisible="{Binding IsEmpty}" Style="{DynamicResource IdrakCaption}" />

            <!-- The groups: rows of two cards (a phone), or a column a group (a wide window); measured as tall as their rows, so the list scrolls. -->
            <ctl:UniformColumns x:Name="Groups" BindableLayout.ItemsSource="{Binding Groups}" Columns="1">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabGroup">
                        <VerticalStackLayout Padding="{DynamicResource IdrakGroupPadding}" Spacing="{DynamicResource IdrakSpacingChip}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacingChip}">
                                <Label Text="{Binding Title}" Style="{DynamicResource IdrakSectionLabel}" />
                                <BoxView Grid.Column="1" HeightRequest="1" Color="{DynamicResource IdrakLine}" VerticalOptions="Center" />
                            </Grid>
                            <ctl:UniformColumns BindableLayout.ItemsSource="{Binding .}" Columns="2" BindableLayout.ItemTemplate="{StaticResource NarrowLab}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </ctl:UniformColumns>
        </VerticalStackLayout>
    </ScrollView>
</ctl:AdaptiveView>
