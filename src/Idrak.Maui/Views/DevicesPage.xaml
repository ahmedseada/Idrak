<?xml version="1.0" encoding="utf-8" ?>
<!-- The Devices feature (plan 34): every device the library finds in the app's own process, as cards. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.DevicesPage"
             x:DataType="vm:DevicesViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Cards}" SelectionMode="None" Margin="{DynamicResource IdrakPagePadding}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}" Padding="0,0,0,12">
                    <Label Text="Devices" Style="{DynamicResource IdrakTitle}" />
                    <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Pull down to read the devices." Style="{DynamicResource IdrakCaption}" HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:InfoCard">
                    <Border Style="{DynamicResource IdrakCard}">
                        <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                            <Label Text="{Binding Title}" Style="{DynamicResource IdrakHeading}" />
                            <Label Text="{Binding Subtitle}" Style="{DynamicResource IdrakCaption}" />
                            <Label Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Style="{DynamicResource IdrakErrorText}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="{DynamicResource IdrakSpacingSmall}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InfoRow">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" Style="{DynamicResource IdrakCaption}" />
                                            <Label Text="{Binding Value}" Style="{DynamicResource IdrakValue}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
