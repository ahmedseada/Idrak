<?xml version="1.0" encoding="utf-8" ?>
<!-- A feature not built yet (plan 34): its title, mark and summary, what it will do and need, from its registration alone. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.PlaceholderPage"
             x:DataType="vm:PlaceholderViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="{DynamicResource IdrakPagePadding}" Spacing="{DynamicResource IdrakSpacing}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource IdrakSpacing}">
                <Label Text="{Binding Glyph}" FontSize="{DynamicResource IdrakFontSizeTitle}" TextColor="{DynamicResource IdrakAccent}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource IdrakSpacingSmall}" VerticalOptions="Center">
                    <Label Text="{Binding Title}" Style="{DynamicResource IdrakTitle}" />
                    <Border Style="{DynamicResource IdrakBadge}" IsVisible="{Binding IsPlanned}">
                        <Label Text="{Binding StateText}" Style="{DynamicResource IdrakBadgeLabel}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
            <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" />

            <Border Style="{DynamicResource IdrakCard}" IsVisible="{Binding HasComing}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="What it will do" Style="{DynamicResource IdrakHeading}" />
                    <Label Text="{Binding Coming}" Style="{DynamicResource IdrakValue}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{DynamicResource IdrakCard}">
                <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                    <Label Text="What it will need" Style="{DynamicResource IdrakHeading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding NeedLines}" Spacing="{DynamicResource IdrakSpacingSmall}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Style="{DynamicResource IdrakValue}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Nothing from the phone" IsVisible="{Binding NeedsNothing}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="The library's packages" IsVisible="{Binding HasPackages}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding Packages}" IsVisible="{Binding HasPackages}" Style="{DynamicResource IdrakValue}" />
                    <Label Text="Model families" IsVisible="{Binding HasModelFamilies}" Style="{DynamicResource IdrakCaption}" />
                    <Label Text="{Binding ModelFamilies}" IsVisible="{Binding HasModelFamilies}" Style="{DynamicResource IdrakValue}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="This page is a placeholder: the feature's own page replaces it when it is built, in the same place in the menu."
                   Style="{DynamicResource IdrakCaption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
