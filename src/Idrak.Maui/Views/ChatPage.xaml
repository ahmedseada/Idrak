<?xml version="1.0" encoding="utf-8" ?>
<!-- The Chat feature (plan 34): a model from the store, its answers streamed into bubbles, the composer at the bottom. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Idrak.Maui.ViewModels"
             x:Class="Idrak.Maui.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New chat" Command="{Binding NewChatCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The model: choose one of the store's, its device, formats and load time, cold and warm speeds. -->
        <Border Style="{DynamicResource IdrakCard}" Margin="16,12,16,0">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                    <Picker ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Title="Choose a model" IsEnabled="{Binding IsIdle}" />
                    <Button Grid.Column="1" Text="Models" Command="{Binding GoToModelsCommand}" Style="{DynamicResource IdrakSecondaryButton}" VerticalOptions="Center" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />
                <Label Text="{Binding ModelText}" Style="{DynamicResource IdrakCaption}" />
                <Label Text="{Binding ColdText}" IsVisible="{Binding HasCold}" Style="{DynamicResource IdrakCaption}" />
                <Label Text="{Binding WarmText}" IsVisible="{Binding HasWarm}" Style="{DynamicResource IdrakCaption}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasThinkingSwitch}">
                    <Label Text="Thinking" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding Thinking}" VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" Style="{DynamicResource IdrakHighlightText}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{DynamicResource IdrakErrorText}" />
            </VerticalStackLayout>
        </Border>

        <!-- The conversation: the user's bubbles on the right, the model's on the left. -->
        <CollectionView x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView" Margin="0,8,0,0">
            <CollectionView.EmptyView>
                <Label Text="Choose a model, then ask something." Style="{DynamicResource IdrakCaption}"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatBubble">
                    <Grid Padding="16,4">
                        <!-- The user's message. -->
                        <Border IsVisible="{Binding IsUser}" HorizontalOptions="End" Margin="48,0,0,0" Padding="14,10"
                                BackgroundColor="{DynamicResource IdrakAccent}" StrokeThickness="0" StrokeShape="RoundRectangle 18,18,18,4">
                            <Label Text="{Binding Text}" TextColor="{DynamicResource IdrakOnAccent}" />
                        </Border>
                        <!-- The model's answer: its reasoning muted above it, what it took below. -->
                        <Border IsVisible="{Binding IsAssistant}" HorizontalOptions="Start" Margin="0,0,48,0" Padding="14,10"
                                BackgroundColor="{DynamicResource IdrakCardBackground}" Stroke="{DynamicResource IdrakCardStroke}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18,18,4,18">
                            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                                <Label Text="{Binding Thinking}" IsVisible="{Binding HasThinking}" Style="{DynamicResource IdrakCaption}" FontAttributes="Italic" />
                                <Label Text="{Binding Text}" />
                                <ActivityIndicator IsRunning="{Binding IsStreaming}" IsVisible="{Binding IsStreaming}" HorizontalOptions="Start" HeightRequest="16" WidthRequest="16" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacingSmall}" IsVisible="{Binding HasFooter}">
                                    <Label Text="{Binding Footer}" Style="{DynamicResource IdrakCaption}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Copy" Command="{Binding CopyCommand}" Style="{DynamicResource IdrakChip}" Margin="0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- The composer: kept above the keyboard (the page resizes the window while it shows). -->
        <Border Grid.Row="2" BackgroundColor="{DynamicResource IdrakCardBackground}" Stroke="{DynamicResource IdrakSeparator}" StrokeThickness="1"
                StrokeShape="Rectangle" Padding="12,8">
            <VerticalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                <Label Text="{Binding LiveText}" Style="{DynamicResource IdrakCaption}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource IdrakSpacing}">
                    <Editor Text="{Binding Draft}" Placeholder="Message" AutoSize="TextChanges" MaximumHeightRequest="160"
                            TextColor="{DynamicResource IdrakText}" PlaceholderColor="{DynamicResource IdrakTextMuted}"
                            FontSize="{DynamicResource IdrakFontSizeBody}" />
                    <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" IsVisible="{Binding IsIdle}" VerticalOptions="End" />
                    <Button Grid.Column="1" Text="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsStreaming}" VerticalOptions="End"
                            Style="{DynamicResource IdrakDangerButton}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
