<?xml version="1.0" encoding="utf-8" ?>
<!--
  The app's host (plan 34, phase R; no Shell, no Blazor): the section shown, with the bottom bar under it on a narrow
  window and the side rail beside it on a wide one, chosen by the window's measured width (AppLayout); All labs as a sheet
  over the page on a narrow window. Pages a section opens are pushed over it (the window's navigation page). Every section
  made is kept in Body, the one shown visible and the others hidden, so a tab tapped again only shows its view. The bottom
  edge follows the soft keyboard (SafeAreaEdges, set in code), and the bottom bar steps aside while the keyboard is up.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nav="clr-namespace:Idrak.Maui.Navigation"
             x:Class="Idrak.Maui.Navigation.AppHostPage"
             x:DataType="nav:AppHostViewModel"
             NavigationPage.HasNavigationBar="False"
             Title="Idrak">
    <Grid ColumnDefinitions="Auto,*">
        <nav:NavigationRail x:Name="Rail" IsVisible="{Binding IsWide}" />

        <Grid Grid.Column="1">
            <Grid x:Name="Body" Margin="{DynamicResource IdrakNoInset}">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding ShowsBottomBar}" Value="True">
                        <Setter Property="Margin" Value="{DynamicResource IdrakBottomBarInset}" />
                    </DataTrigger>
                </Grid.Triggers>
            </Grid>

            <!-- All labs over the page (a narrow window). -->
            <Grid x:Name="Sheet" IsVisible="{Binding IsSheetOpen}">
                <BoxView Color="{DynamicResource IdrakScrim}">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSheetCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <!-- The sheet: its ground (the rounded edge) under a plain grid, so the list scrolls in a row of a fixed height. -->
                <Grid x:Name="SheetPanel" VerticalOptions="End">
                    <Border Style="{DynamicResource IdrakSheet}" InputTransparent="True" />
                    <Grid RowDefinitions="Auto,*" Padding="{DynamicResource IdrakSheetPadding}">
                        <Border Style="{DynamicResource IdrakSheetHandle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseSheetCommand}" />
                                <SwipeGestureRecognizer Direction="Down" Command="{Binding CloseSheetCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <ContentView x:Name="SheetBody" Grid.Row="1" />
                    </Grid>
                </Grid>
            </Grid>

            <nav:BottomNavigationBar x:Name="Bar" VerticalOptions="End" IsVisible="{Binding ShowsBottomBar}" />
        </Grid>
    </Grid>
</ContentPage>
