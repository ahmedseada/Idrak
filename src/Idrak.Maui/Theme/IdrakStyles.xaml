        <Setter Property="FontFamily" Value="{DynamicResource IdrakFontExtraBold}" />
        <Setter Property="FontSize" Value="{DynamicResource IdrakFontSizeStat}" />
        <Setter Property="CharacterSpacing" Value="-0.3" />
