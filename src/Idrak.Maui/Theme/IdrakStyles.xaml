<?xml version="1.0" encoding="utf-8" ?>
<!--
  Idrak's look (plan 34, phase R: the approved design, apps/Idrak.Mobile/Design): the type scale, spacing and corner radii
  as keys, and the styles that use them with the colours of the theme in effect (IdrakLightColors or IdrakDarkColors,
  swapped by IdrakThemes.Apply) through DynamicResource, so a theme change restyles every page at once. Inter for text and
  JetBrains Mono for figures and code (the app bundles both; without them the system's fonts stand in). No fixed heights
  around text, so the phone's text size has room. The app merges this dictionary in its App.xaml; a key or style of the
  same name in the app's own resources wins.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:theme="clr-namespace:Idrak.Maui.Theme"
                    x:Class="Idrak.Maui.Theme.IdrakStyles">

    <!-- The icons (IdrakIcons.xaml), merged here so an app that merges the styles has them too. -->
    <ResourceDictionary.MergedDictionaries>
        <theme:IdrakIconDictionary />
    </ResourceDictionary.MergedDictionaries>

    <!-- Fonts (the aliases the app registers; an alias it lacks falls back to the system's font). -->
    <x:String x:Key="IdrakFontRegular">Inter</x:String>
    <x:String x:Key="IdrakFontMedium">InterMedium</x:String>
    <x:String x:Key="IdrakFontSemiBold">InterSemiBold</x:String>
    <x:String x:Key="IdrakFontBold">InterBold</x:String>
    <x:String x:Key="IdrakFontExtraBold">InterExtraBold</x:String>
    <x:String x:Key="IdrakFontMono">JetBrainsMono</x:String>
    <x:String x:Key="IdrakFontMonoBold">JetBrainsMonoBold</x:String>

    <!-- Type sizes (scaled by the phone's text size setting). -->
    <x:Double x:Key="IdrakFontSizeHero">30</x:Double>
    <x:Double x:Key="IdrakFontSizeTitle">26</x:Double>
    <x:Double x:Key="IdrakFontSizeLarge">22</x:Double>
    <x:Double x:Key="IdrakFontSizeHeading">16</x:Double>
    <x:Double x:Key="IdrakFontSizeStat">16</x:Double>
    <x:Double x:Key="IdrakFontSizeBody">14</x:Double>
    <x:Double x:Key="IdrakFontSizeCaption">12.5</x:Double>
    <x:Double x:Key="IdrakFontSizeSmall">11.5</x:Double>
    <x:Double x:Key="IdrakFontSizeLabel">11</x:Double>
    <x:Double x:Key="IdrakFontSizeMicro">10.5</x:Double>
    <x:Double x:Key="IdrakFontSizeBadge">11</x:Double>
    <x:Double x:Key="IdrakFontSizeTimer">22</x:Double>
    <x:Double x:Key="IdrakFontSizeTimerSmall">14</x:Double>
    <x:Double x:Key="IdrakFontSizeBigNumber">30</x:Double>
    <x:Double x:Key="IdrakFontSizeCode">11.5</x:Double>

    <!-- Spacing. -->
    <x:Double x:Key="IdrakSpacingTiny">3</x:Double>
    <x:Double x:Key="IdrakSpacingSmall">6</x:Double>
    <x:Double x:Key="IdrakSpacingChip">8</x:Double>
    <x:Double x:Key="IdrakSpacingTile">10</x:Double>
    <x:Double x:Key="IdrakSpacing">12</x:Double>
    <x:Double x:Key="IdrakSpacingSection">14</x:Double>
    <x:Double x:Key="IdrakSpacingLarge">20</x:Double>
    <x:Double x:Key="IdrakSpacingColumns">22</x:Double>
    <x:Double x:Key="IdrakSpacingRecord">34</x:Double>
    <Thickness x:Key="IdrakBadgePadding">8,2</Thickness>
    <Thickness x:Key="IdrakMenuHeaderPadding">20,28,20,16</Thickness>
    <Thickness x:Key="IdrakMenuItemPadding">20,12</Thickness>
    <Thickness x:Key="IdrakPagePadding">20,8,20,16</Thickness>
    <Thickness x:Key="IdrakWidePagePadding">28,20,28,20</Thickness>
    <Thickness x:Key="IdrakCardPadding">16,14</Thickness>
    <Thickness x:Key="IdrakCardMargin">0,0,0,12</Thickness>
    <Thickness x:Key="IdrakSectionPadding">0,0,0,12</Thickness>
    <Thickness x:Key="IdrakSectionHeaderPadding">0,18,0,10</Thickness>
    <Thickness x:Key="IdrakChipPadding">12,6</Thickness>
    <Thickness x:Key="IdrakChipMargin">0,0,8,8</Thickness>
    <Thickness x:Key="IdrakBottomBarInset">0,0,0,92</Thickness>
    <Thickness x:Key="IdrakSheetPadding">18,10,18,0</Thickness>
    <Thickness x:Key="IdrakNoInset">0</Thickness>
    <Thickness x:Key="IdrakTopGap">0,12,0,0</Thickness>
    <Thickness x:Key="IdrakTopGapSmall">0,6,0,0</Thickness>
    <Thickness x:Key="IdrakBottomGap">0,0,0,24</Thickness>
    <Thickness x:Key="IdrakComposerPadding">14,8,14,10</Thickness>
    <Thickness x:Key="IdrakFeedPadding">16,6,16,12</Thickness>
    <Thickness x:Key="IdrakWideFeedPadding">44,20,44,12</Thickness>
    <Thickness x:Key="IdrakUserBubbleMargin">56,0,0,0</Thickness>
    <Thickness x:Key="IdrakListIndent">18,0,0,0</Thickness>
    <Thickness x:Key="IdrakPaneHeaderPadding">28,16</Thickness>
    <Thickness x:Key="IdrakPanePadding">16,20</Thickness>
    <Thickness x:Key="IdrakHeaderPadding">0,4,0,10</Thickness>
    <Thickness x:Key="IdrakCarouselPeek">0,0,44,0</Thickness>
    <Thickness x:Key="IdrakNavBarPadding">14,10,14,12</Thickness>
    <Thickness x:Key="IdrakRailPadding">0,14,0,22</Thickness>
    <Thickness x:Key="IdrakRailItemMargin">0,0,0,18</Thickness>
    <Thickness x:Key="IdrakRailLogoMargin">0,0,0,26</Thickness>
    <Thickness x:Key="IdrakLabPadding">20,4,20,12</Thickness>
    <Thickness x:Key="IdrakSectionTopPadding">20,4,20,12</Thickness>
    <Thickness x:Key="IdrakWideSectionTopPadding">26,20,26,14</Thickness>
    <Thickness x:Key="IdrakChatTopPadding">16,6,16,6</Thickness>
    <Thickness x:Key="IdrakWideChatTopPadding">28,16,28,10</Thickness>
    <Thickness x:Key="IdrakControlsPadding">0,10,0,8</Thickness>
    <Thickness x:Key="IdrakBubblePadding">0,6</Thickness>
    <Thickness x:Key="IdrakLabCellPadding">4</Thickness>
    <Thickness x:Key="IdrakGroupPadding">0,4,0,10</Thickness>
    <Thickness x:Key="IdrakWideGroupPadding">0,0,16,0</Thickness>
    <Thickness x:Key="IdrakGroupHeaderMargin">4,16,4,4</Thickness>
    <Thickness x:Key="IdrakSettingRowPadding">0,4</Thickness>
    <Thickness x:Key="IdrakTileWaveMargin">10,0,0,0</Thickness>
    <Thickness x:Key="IdrakTimestampMargin">0,3,0,0</Thickness>
    <Thickness x:Key="IdrakTranscriptLinePadding">0,5</Thickness>
    <Thickness x:Key="IdrakEmptyPhotoPadding">16,28</Thickness>
    <Thickness x:Key="IdrakPhotoLabelMargin">12,10,12,6</Thickness>

    <!-- Corner radii. -->
    <x:Double x:Key="IdrakCornerRadius">20</x:Double>
    <x:Int32 x:Key="IdrakButtonCornerRadius">14</x:Int32>
    <x:Int32 x:Key="IdrakChipCornerRadius">14</x:Int32>
    <x:Int32 x:Key="IdrakPillCornerRadius">21</x:Int32>

    <!-- Pages and navigation. -->
