<?xml version="1.0" encoding="utf-8" ?>
<!-- The light theme's colours (plan 34): the ground, sky and amber of the library's icon (assets/icon.svg). Every key may be
     overridden by the app (a key in its own App.xaml resources wins over the merged dictionaries). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Idrak.Maui.Theme.IdrakLightColors">
    <!-- The icon's own colours. -->
    <Color x:Key="IdrakGround">#0B1020</Color>
    <Color x:Key="IdrakSky">#38BDF8</Color>
    <Color x:Key="IdrakAmber">#F59E0B</Color>
    <Color x:Key="IdrakWhite">#FFFFFF</Color>

    <!-- What pages use. -->
    <Color x:Key="IdrakPageBackground">#F4F6FB</Color>
    <Color x:Key="IdrakCardBackground">#FFFFFF</Color>
    <Color x:Key="IdrakCardStroke">#E2E8F0</Color>
    <Color x:Key="IdrakText">#0B1020</Color>
    <Color x:Key="IdrakTextMuted">#475569</Color>
    <Color x:Key="IdrakAccent">#0284C7</Color>
    <Color x:Key="IdrakOnAccent">#FFFFFF</Color>
    <Color x:Key="IdrakHighlight">#B45309</Color>
    <Color x:Key="IdrakError">#DC2626</Color>
    <Color x:Key="IdrakSuccess">#15803D</Color>
    <Color x:Key="IdrakFlyoutBackground">#FFFFFF</Color>
    <Color x:Key="IdrakSeparator">#E2E8F0</Color>
    <Color x:Key="IdrakBarBackground">#0B1020</Color>
    <Color x:Key="IdrakBarText">#FFFFFF</Color>
    <Color x:Key="IdrakBadgeBackground">#FEF3C7</Color>
    <Color x:Key="IdrakBadgeForeground">#92400E</Color>
    <Color x:Key="IdrakBadgeStroke">#F59E0B</Color>
</ResourceDictionary>
