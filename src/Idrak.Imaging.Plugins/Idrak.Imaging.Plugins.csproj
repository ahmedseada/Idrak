<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Imaging.Plugins</RootNamespace>
    <AssemblyName>Idrak.Imaging.Plugins</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Imaging.Plugins</PackageId>
    <Description>Image and font formats for Idrak on the library's public API (one namespace per kind): WOFF fonts read and written (Fonts: WoffFormat and WoffWriter, made and called directly; the font inside read by Idrak.Imaging's OpenType reader and written by its TrueType writer).</Description>
  </PropertyGroup>

  <!-- Plan 26: a plug-in package uses the library's public API only; no library assembly grants it internals. Plan 28,
       decision 21: it builds on Idrak.Imaging, whose "opentype" reader (OpenTypeFormat) and "truetype" writer
       (TrueTypeWriter) it reaches directly. -->
  <ItemGroup>
    <ProjectReference Include="..\Idrak.Imaging\Idrak.Imaging.csproj" />
  </ItemGroup>

</Project>
