<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Data</RootNamespace>
    <AssemblyName>Idrak.Data</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Data</PackageId>
    <Description>Datasets for Idrak (no dependencies beyond Idrak and Idrak.Imaging): read JSON Lines, JSON, CSV, text and Parquet files, archives and compressed files; download and cache from URLs, Hugging Face, GitHub, Kaggle and Zenodo; filter, map, shuffle, deduplicate, split, mix and turn rows into chat transcripts for fine-tuning, or columns into training samples.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The PDF reader's object layer (internal) is checked object by object against the samples' expected forms. -->
    <InternalsVisibleTo Include="Idrak.Tests" />
    <InternalsVisibleTo Include="Idrak.Tests.Library" />
    <!-- Idrak.Text's synthetic documents reach the default document writer (pdf) directly. -->
    <InternalsVisibleTo Include="Idrak.Text" />
  </ItemGroup>

  <ItemGroup>
    <!-- TableSamples turns columns into Idrak's sample sources. -->
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
    <!-- The PDF reader's and writer's defaults: the bidi reading order, the coverage page drawer, the TrueType font writer,
         the JPEG encoder and the shaped text setter. -->
    <ProjectReference Include="..\Idrak.Imaging\Idrak.Imaging.csproj" />
  </ItemGroup>

</Project>
