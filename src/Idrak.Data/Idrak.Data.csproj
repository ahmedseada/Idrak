<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Data</RootNamespace>
    <AssemblyName>Idrak.Data</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Data</PackageId>
    <Description>Datasets for Idrak (no dependencies beyond Idrak): read JSON Lines, JSON, CSV, text and Parquet files, archives and compressed files; download and cache from URLs, Hugging Face, GitHub, Kaggle and Zenodo; filter, map, shuffle, deduplicate, split, mix and turn rows into chat transcripts for fine-tuning, or columns into training samples.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- TableSamples turns columns into Idrak's sample sources. -->
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
  </ItemGroup>

</Project>
