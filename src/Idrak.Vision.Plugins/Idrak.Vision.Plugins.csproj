<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Vision.Plugins</RootNamespace>
    <AssemblyName>Idrak.Vision.Plugins</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Vision.Plugins</PackageId>
    <Description>The vision model families for Idrak, as plug-ins on the library's public API (one namespace per family): reference it and call VisionPlugins.RegisterAll(), or register one family with its own Register().</Description>
  </PropertyGroup>

  <!-- Plan 26: a plug-in package uses the library's public API only; no library assembly grants it internals. -->
  <ItemGroup>
    <ProjectReference Include="..\Idrak.Vision\Idrak.Vision.csproj" />
    <!-- Vision-language families register their text decoders through the text plug-ins (one way: vision on text). -->
    <ProjectReference Include="..\Idrak.Text.Plugins\Idrak.Text.Plugins.csproj" />
  </ItemGroup>

</Project>
