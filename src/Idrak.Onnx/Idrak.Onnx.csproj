<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Onnx</RootNamespace>
    <AssemblyName>Idrak.Onnx</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Onnx</PackageId>
    <Description>ONNX export for Idrak models (no dependencies): networks become .onnx files that ONNX Runtime, TensorRT, OpenVINO, DirectML and other runtimes can run.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
  </ItemGroup>

</Project>
