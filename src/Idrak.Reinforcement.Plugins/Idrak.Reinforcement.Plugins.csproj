<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.Reinforcement.Plugins</RootNamespace>
    <AssemblyName>Idrak.Reinforcement.Plugins</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Idrak.Reinforcement.Plugins</PackageId>
    <Description>The reinforcement-learning environment families for Idrak, as plug-ins on the library's public API (one namespace per family): reference it and call ReinforcementPlugins.RegisterAll(), or register one family with its own Register().</Description>
  </PropertyGroup>

  <!-- Plan 26: a plug-in package uses the library's public API only; no library assembly grants it internals. -->
  <ItemGroup>
    <ProjectReference Include="..\Idrak.Reinforcement\Idrak.Reinforcement.csproj" />
    <!-- Environments that are conversations (a coding task) run on the chat models and tools of Idrak.Text (one way: the plug-ins on the packages). -->
    <ProjectReference Include="..\Idrak.Text\Idrak.Text.csproj" />
  </ItemGroup>

</Project>
