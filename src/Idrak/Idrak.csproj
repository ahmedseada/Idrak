<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak</RootNamespace>
    <AssemblyName>Idrak</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Idrak</PackageId>
    <Description>Self-contained neural network library for .NET: tensors, autograd, layers and optimizers with a SIMD CPU backend, datasets and loaders, ONNX export and import, the inference engine and model loading. The GPU devices are Idrak.Gpu (CUDA, Vulkan, HIP), images Idrak.Imaging. No TensorFlow, no native dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak.Abstraction\Idrak.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Idrak.Abstraction.Devices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Idrak.Tests" />
    <InternalsVisibleTo Include="Idrak.Text" />
  </ItemGroup>

</Project>
