      "council", "authority", "municipality", "region", "office", "building", "unit", "license", "permit", "certificate", "document",
      "right", "obligation", "term", "clause", "period", "deadline", "date", "value", "fees", "tax", "sale", "purchase", "delivery",
      "event", "conference"],
    "adjective": ["general", "technical", "administrative", "commercial", "annual", "monthly", "said", "issued", "final", "initial", "necessary",
