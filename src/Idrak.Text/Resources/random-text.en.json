{
  "name": "en",
  "summary": "English in the words of official and legal letters: courts, cases, rulings, departments, names, places, years, dates and amounts (not meaningful sentences)",
  "years": [1990, 2030],
  "punctuation": [",", ",", ",", ";", ":", "."],
  "end": [".", ".", ".", "?", ":"],
  "patterns": [
    ["determiner", "noun", "verb", "determiner", "noun"],
    ["determiner", "adjective", "noun"],
    ["preposition", "determiner", "noun"],
    ["preposition", "determiner", "adjective", "noun"],
    ["connector"],
    ["noun", "=No.", "#number"],
    ["preposition", "place"],
    ["title", "given", "family"],
    ["given", "family"],
    ["=on", "#date"],
    ["=in", "#year"],
    ["#amount", "currency"],
    ["determiner", "noun", "=of", "determiner", "noun"],
    ["auxiliary", "verb"]
  ],
  "pools": {
    "noun": ["court", "case", "ruling", "claimant", "defendant", "request", "decision", "ministry", "department", "file", "contract", "company",
      "employee", "hearing", "claim", "appeal", "enforcement", "deed", "regulation", "article", "paragraph", "agent", "witness", "evidence",
