      "payment", "fine", "penalty", "compensation", "damage", "objection", "complaint", "investigation", "prosecution", "defence", "lawyer",
      "judge", "clerk", "register", "copy", "signature", "stamp", "approval", "referral", "jurisdiction", "committee", "council", "authority",
      "municipality", "region", "office", "building", "unit", "license", "permit", "certificate", "document", "right", "obligation", "term",
      "clause", "period", "deadline", "date", "value", "fees", "tax", "sale", "purchase", "settlement", "arbitration", "objection", "oath"],
    "adjective": ["general", "criminal", "administrative", "commercial", "competent", "said", "issued", "final", "initial", "necessary",
      "respected", "official", "approved", "previous", "current", "first", "second", "last", "new", "full", "partial", "due", "remaining",
      "required", "private", "public", "legal", "financial", "personal", "attached", "urgent", "confidential", "valid", "void", "temporary"],
    "verb": ["submitted", "issued", "decided", "stated", "requested", "ruled", "reviewed", "referred", "proved", "approved", "rejected",
