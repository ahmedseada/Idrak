{
  "name": "en",
  "summary": "English in the words of ordinary letters, reports and news: offices, projects, meetings, services, names, places, years, dates and amounts (not meaningful sentences)",
  "years": [1990, 2030],
  "punctuation": [",", ",", ",", ";", ":", "."],
  "end": [".", ".", ".", "?", ":"],
  "patterns": [
    ["determiner", "noun", "verb", "determiner", "noun"],
    ["determiner", "adjective", "noun"],
    ["preposition", "determiner", "noun"],
    ["preposition", "determiner", "adjective", "noun"],
    ["connector"],
    ["noun", "=No.", "#number"],
    ["preposition", "place"],
    ["title", "given", "family"],
    ["given", "family"],
    ["=on", "#date"],
    ["=in", "#year"],
    ["#amount", "currency"],
    ["determiner", "noun", "=of", "determiner", "noun"],
    ["auxiliary", "verb"]
  ],
  "pools": {
    "noun": ["report", "project", "meeting", "team", "customer", "product", "request", "decision", "department", "file", "contract", "company",
