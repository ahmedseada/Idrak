<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Idrak.Datasets.Cli</RootNamespace>
    <AssemblyName>idrak-data</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>idrak-data</ToolCommandName>
    <PackageId>Idrak.Datasets.Cli</PackageId>
    <Description>idrak-data: inspect, count, download and assemble training datasets from Hugging Face, GitHub, Kaggle, Zenodo, URLs and local files (JSON Lines, JSON, CSV, text, code, Parquet) into JSON Lines any tool can read.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idrak.Datasets\Idrak.Datasets.csproj" />
  </ItemGroup>

  <!-- The tool's code is shared with idrak (idrak tune / idrak data): one source, two entry points. -->
  <ItemGroup>
    <Compile Include="..\Idrak.Cli\Commands\Data\DataTool.cs" Link="DataTool.cs" />
    <Compile Include="..\Idrak.Cli\Shared\ToolConsole.cs" Link="ToolConsole.cs" />
  </ItemGroup>

</Project>
