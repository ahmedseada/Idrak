<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Idrak.AspNetCore</RootNamespace>
    <AssemblyName>Idrak.AspNetCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Idrak.AspNetCore</PackageId>
    <Description>Serve Idrak models over HTTP from an ASP.NET Core app: predictions, text generation, chat and an OpenAI-compatible /v1 API (chat completions, embeddings), as thin endpoints over the inference engine. AddIdrak() registers the engine; MapPredictor, MapGenerate, MapChatApi, MapCompletionsApi and MapIdrakStatus map the endpoints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Idrak\Idrak.csproj" />
  </ItemGroup>

</Project>
