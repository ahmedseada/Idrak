<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows program's manifest. Per-monitor DPI awareness, version 2 (Windows 10 1703 and later), with per-monitor
     (version 1) for older systems: the window is drawn at each display's own scale and redrawn sharp as it moves between
     displays of different scales, never stretched by the system. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Idrak.Mobile.WinUI.app" />
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
