<?xml version="1.0" encoding="utf-8"?>
<!-- The minimum SDK (26, Android 8.0: AAudio) comes from SupportedOSPlatformVersion in the project. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Idrak"></application>
	<!-- Model downloads. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Live transcription and recording (asked at first use). -->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<!-- Reading a photo from the camera (asked at first use). -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.microphone" android:required="false" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<!-- MediaPicker (the OCR and Image labs), as MAUI documents it: reading a picked photo and keeping a taken one on
	     Android 12L and older (storage permissions end at API 32; newer phones use the system photo picker, which needs
	     none). The file provider the camera writes through is MAUI Essentials' own, merged from its library manifest. -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<!-- MediaPicker's camera on Android 11 (API 30) and newer: the camera app is found through package visibility. -->
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
