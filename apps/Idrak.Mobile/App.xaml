<?xml version="1.0" encoding="utf-8" ?>
<!-- The app merges Idrak's styles; IdrakThemes.Apply adds the light or dark colours. A key set here wins over both. -->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:Idrak.Maui.Theme;assembly=Idrak.Maui"
             x:Class="Idrak.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:IdrakStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
