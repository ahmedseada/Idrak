<?xml version="1.0" encoding="utf-8" ?>
<!-- The flyout's menu: every registered feature the settings show (a planned one marked "planned"), then the settings. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Idrak.Mobile"
             x:Class="Idrak.Mobile.MenuPage"
             x:DataType="local:MenuPage"
             Title="Idrak"
             BackgroundColor="{DynamicResource IdrakFlyoutBackground}">
    <CollectionView x:Name="MenuList" ItemsSource="{Binding Entries}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
        <CollectionView.Header>
            <VerticalStackLayout Padding="{DynamicResource IdrakMenuHeaderPadding}" Spacing="{DynamicResource IdrakSpacingSmall}">
                <Label Text="Idrak" Style="{DynamicResource IdrakTitle}" />
                <Label Text="The library on this phone" Style="{DynamicResource IdrakCaption}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:MenuEntry">
                <Grid ColumnDefinitions="36,*" Padding="{DynamicResource IdrakMenuItemPadding}" ColumnSpacing="{DynamicResource IdrakSpacing}">
                    <Label Text="{Binding Glyph}" FontSize="{DynamicResource IdrakFontSizeHeading}" TextColor="{DynamicResource IdrakAccent}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="{DynamicResource IdrakSpacingSmall}">
                            <Label Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Style="{DynamicResource IdrakBadge}" IsVisible="{Binding IsPlanned}">
                                <Label Text="planned" Style="{DynamicResource IdrakBadgeLabel}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding Summary}" Style="{DynamicResource IdrakCaption}" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
