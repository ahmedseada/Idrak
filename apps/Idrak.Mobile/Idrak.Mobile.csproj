<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Idrak.Mobile (plan 34): the library on a phone or a tablet, as an app, and on a Windows laptop or desktop (phase W);
    iOS is held. It references the library as packages, which apps/Directory.Build.targets turns into this clone's
    projects.

    The targets: net10.0-android everywhere; net10.0-windows10.0.19041.0 too when the build runs on Windows (MSBuild's
    IsOSPlatform, MAUI's own template pattern: the WinUI tools run only there), so a Linux build is the Android one alone.
    On Windows the project has both targets, so a command names the one it builds with -f.

    Visual Studio: open apps/Idrak.Mobile.slnx, make Idrak.Mobile the startup project, pick the Android target and the
    phone (USB debugging on), or the Windows target and Windows Machine. The command line, Android:
      dotnet build -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-android -t:Install
    (with -p:AndroidSdkDirectory=FOLDER when the Android SDK is not where the tools look; -f may be left out off Windows).
    Windows (Visual Studio's .NET MAUI workload has the Windows tools; the command line needs
    dotnet workload install maui-windows once), built and then run from the build folder:
      dotnet build -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-windows10.0.19041.0
      apps/Idrak.Mobile/bin/Release/net10.0-windows10.0.19041.0/win-x64/Idrak.Mobile.exe
    or published with the start-up pre-compiled (IdrakWindowsAot below) into a folder to run from:
      dotnet publish -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-windows10.0.19041.0 -p:RuntimeIdentifierOverride=win-x64 -o test-output/windows/publish
    (RuntimeIdentifierOverride, not -r: -r reaches the restore of every target, and the Android one then asks for a Mono runtime for Windows.)

    The runtime: IdrakAndroidRuntime, mono (the default, .NET for Android's own) or coreclr, so both can be built and
    measured against each other (the Devices lab's runtime line, the Chat lab's tokens per second):
      dotnet build -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -t:Install -p:IdrakAndroidRuntime=coreclr
    It sets UseMonoRuntime (true for mono, false for coreclr); any other value stops the build.

    The ahead-of-time compilation on Mono, IdrakAndroidAot (Release builds; CoreCLR builds take none of these):
      full      (the default) every method compiled ahead, so no UI code is compiled on a first touch: the taps, the tabs,
                the settings and the scroll answer at once from the first time (the APK is larger: 60.6 MB against profiled's
                36.1 MB, both ABIs, measured October 2026; the arm64 ahead-of-time code 51 MB unpacked against 11 MB);
      llvm      full, and through LLVM's optimizer (faster code, a longer build, a somewhat larger APK);
      profiled  .NET for Android's own default: only the start-up methods its profile names, the rest compiled by the JIT
                when first run (the smallest APK; a first tap on each page waits for its code to compile);
      none      no ahead-of-time code at all (the JIT only).
      dotnet build -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-android -t:Install -p:IdrakAndroidAot=profiled
    Any other value stops the build. The two Android settings apply to the Android target only.

    The Windows package, IdrakWindowsPackage (the Windows target only):
      none      (the default) unpackaged: WindowsPackageType None, a plain .exe run from the build folder or Visual Studio,
                no certificate; the Windows App SDK's runtime goes with it (WindowsAppSDKSelfContained, unless set), so
                the folder runs on a machine without that runtime installed;
      msix      an MSIX package (Platforms/Windows/Package.appxmanifest, the microphone declared as its device
                capability), installed and signed as Windows' packages are:
      dotnet build -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-windows10.0.19041.0 -p:IdrakWindowsPackage=msix
    Any other value stops the build.

    The ahead-of-time compilation on Windows, IdrakWindowsAot (the Windows target only; full AOT is Android's):
      readytorun  (the default) the app's and the library's code pre-compiled for the machine (PublishReadyToRun), so
                  the start-up and a first tap need no JIT; taken by dotnet publish (a dotnet build runs on the JIT, as
                  a debug run does);
      none        no pre-compiled code (the JIT only), to measure against.
      dotnet publish -c Release apps/Idrak.Mobile/Idrak.Mobile.csproj -f net10.0-windows10.0.19041.0 -p:RuntimeIdentifierOverride=win-x64 -p:IdrakWindowsAot=none -o test-output/windows/publish-jit
    Any other value stops the build.
  -->
  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFramework>
    <!-- On Windows both targets: the root Directory.Build.props sets TargetFramework (one target), cleared here. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))"></TargetFramework>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Idrak.Mobile</RootNamespace>
    <ApplicationTitle>Idrak</ApplicationTitle>
    <ApplicationId>io.github.ahmedseada.idrak</ApplicationId>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IdrakAndroidRuntime Condition="'$(IdrakAndroidRuntime)' == ''">mono</IdrakAndroidRuntime>
    <IdrakAndroidAot Condition="'$(IdrakAndroidAot)' == ''">full</IdrakAndroidAot>
    <IdrakWindowsPackage Condition="'$(IdrakWindowsPackage)' == ''">none</IdrakWindowsPackage>
    <IdrakWindowsAot Condition="'$(IdrakWindowsAot)' == ''">readytorun</IdrakWindowsAot>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- AAudio (the library's sound on Android) is Android 8.0, API 26. -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <UseMonoRuntime Condition="'$(IdrakAndroidRuntime)' == 'mono'">true</UseMonoRuntime>
    <UseMonoRuntime Condition="'$(IdrakAndroidRuntime)' == 'coreclr'">false</UseMonoRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(UseMonoRuntime)' == 'true' and '$(Configuration)' == 'Release'">
    <RunAOTCompilation Condition="'$(IdrakAndroidAot)' != 'none'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(IdrakAndroidAot)' == 'none'">false</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(IdrakAndroidAot)' == 'profiled'">true</AndroidEnableProfiledAot>
    <AndroidEnableProfiledAot Condition="'$(IdrakAndroidAot)' == 'full' or '$(IdrakAndroidAot)' == 'llvm'">false</AndroidEnableProfiledAot>
    <EnableLLVM Condition="'$(IdrakAndroidAot)' == 'llvm'">true</EnableLLVM>
  </PropertyGroup>

  <!--
    Windows: 10 1809 (10.0.17763.0) and later, as MAUI's Windows apps. The WinUI side of the app is Platforms/Windows:
    App.xaml and App.xaml.cs (the WinUI application, MauiWinUIApplication, which builds the MAUI app), app.manifest
    (per-monitor DPI, version 2, so the window is sharp on every display as it moves between them) and
    Package.appxmanifest (the MSIX package's, used with IdrakWindowsPackage=msix). The icon is the MauiIcon below, which
    MAUI's resizer makes into the Windows icon and the package's logos.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType Condition="'$(IdrakWindowsPackage)' == 'none'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(IdrakWindowsPackage)' == 'msix'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(IdrakWindowsPackage)' == 'none' and '$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <PublishReadyToRun Condition="'$(IdrakWindowsAot)' == 'readytorun'">true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(IdrakWindowsAot)' == 'none'">false</PublishReadyToRun>
  </PropertyGroup>

  <Target Name="IdrakAndroidRuntimeCheck" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(IdrakAndroidRuntime)' != 'mono' and '$(IdrakAndroidRuntime)' != 'coreclr'"
           Text="IdrakAndroidRuntime is '$(IdrakAndroidRuntime)': use mono (the default) or coreclr." />
    <Error Condition="'$(IdrakAndroidAot)' != 'full' and '$(IdrakAndroidAot)' != 'llvm' and '$(IdrakAndroidAot)' != 'profiled' and '$(IdrakAndroidAot)' != 'none'"
           Text="IdrakAndroidAot is '$(IdrakAndroidAot)': use full (the default), llvm, profiled or none." />
    <Error Condition="'$(IdrakWindowsPackage)' != 'none' and '$(IdrakWindowsPackage)' != 'msix'"
           Text="IdrakWindowsPackage is '$(IdrakWindowsPackage)': use none (the default, unpackaged) or msix." />
    <Error Condition="'$(IdrakWindowsAot)' != 'readytorun' and '$(IdrakWindowsAot)' != 'none'"
           Text="IdrakWindowsAot is '$(IdrakWindowsAot)': use readytorun (the default) or none." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Idrak.Maui" Version="$(IdrakVersion)" />
    <!-- The text families the Chat lab shows, each registered by its own call in MauiProgram. -->
    <PackageReference Include="Idrak.Text.Plugins" Version="$(IdrakVersion)" />
    <!-- The speech families the Transcribe and Speak labs read, registered one by one in MauiProgram (never espeak-ng). -->
    <PackageReference Include="Idrak.Audio.Plugins" Version="$(IdrakVersion)" />
    <!-- The vision-language families the OCR lab reads with, registered one by one in MauiProgram. -->
    <PackageReference Include="Idrak.Vision.Plugins" Version="$(IdrakVersion)" />
  </ItemGroup>

  <!-- The Terminal page's commands: the idrak tool's commands as a library, run in the app's process (IdrakCommandRunner).
       Part of the tool, not a package, so taken from this clone's source. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Idrak.Cli.Commands\Idrak.Cli.Commands.csproj" />
    <!-- No plug-in or tool DLLs loaded in the app (the CLI options -P and tools): the trimmer drops the CLI's assembly loading, and those options are refused by name. -->
    <RuntimeHostConfigurationOption Include="Idrak.Cli.LoadAssemblies" Value="false" Trim="true" />
  </ItemGroup>

  <!--
    The library's icon is the app's icon (assets/icon.svg). The launcher's adaptive icon takes the icon's dark ground as
    its background and the graph mark as its foreground: the icon without its rounded square, which the launcher's own
    mask replaces. The mark is made from the repository's SVG at every build (the rounded square, the one <rect> with
    rounded corners, taken out), so the two never drift apart.

    The system splash (plan 34, phase S) follows the system's theme, made from the same SVG at every build:
      Android, light (the default resources): the icon's tile (the whole icon, its dark rounded square with the mark) on
        IdrakSplashGround, the light page ground (Idrak.Maui's light IdrakPageBackground); MAUI's MauiSplashScreen makes
        it (maui_splash_color, maui_splash_image and its pictures);
      Android, dark (the -night resources, IdrakSplashNight below): the bare mark on IdrakSplashNightGround, the icon's
        ground; the mark's pictures are a MauiImage (MAUI's resizer, the same sizes as the splash's), and the night colour
        and the two drawables that place it (the one before Android 12, the one for Android 12's own splash) are written
        beside them in the shape MAUI writes its own, so Maui.SplashTheme picks the night ones on a phone in dark mode;
      Windows (the MSIX package's splash, IdrakWindowsPackage=msix): one colour only, so the dark variant, the bare mark
        on IdrakSplashNightGround; an unpackaged .exe has no system splash.
    Android 12 and later clip the splash icon to the launcher's icon mask, at most the circle inside the picture, so the
    tile is drawn at IdrakSplashTileScale of the picture: 0.8 keeps its rounded corners inside that circle (the tile's
    corner reaches 314.8 units from the centre of the 512-unit icon, the circle 256). The bare mark fits as it is.
    IdrakSplashBaseSize is the splash picture's size in dp before Android 12 (Android 12 sizes the icon itself).
  -->
  <PropertyGroup>
    <IdrakIconSource>$(MSBuildThisFileDirectory)../../assets/icon.svg</IdrakIconSource>
    <IdrakIconGround>#0b1020</IdrakIconGround>
    <IdrakIconMark>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'icon', 'idrakmark.svg'))</IdrakIconMark>
    <IdrakSplashGround Condition="'$(IdrakSplashGround)' == ''">#f4f6fb</IdrakSplashGround>
    <IdrakSplashNightGround Condition="'$(IdrakSplashNightGround)' == ''">$(IdrakIconGround)</IdrakSplashNightGround>
    <IdrakSplashTileScale Condition="'$(IdrakSplashTileScale)' == ''">0.8</IdrakSplashTileScale>
    <IdrakSplashBaseSize Condition="'$(IdrakSplashBaseSize)' == ''">160,160</IdrakSplashBaseSize>
    <IdrakSplashTile>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'icon', 'idraksplash.svg'))</IdrakSplashTile>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="$(IdrakIconMark)" Color="$(IdrakIconGround)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiSplashScreen Include="$(IdrakSplashTile)" Color="$(IdrakSplashGround)" BaseSize="$(IdrakSplashBaseSize)" />
    <!-- The night splash's mark (drawable idrakmark), placed by the drawables IdrakSplashNight writes. -->
    <MauiImage Include="$(IdrakIconMark)" BaseSize="$(IdrakSplashBaseSize)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <MauiSplashScreen Include="$(IdrakIconMark)" Color="$(IdrakSplashNightGround)" BaseSize="$(IdrakSplashBaseSize)" />
  </ItemGroup>

  <!--
    The fonts of the approved design (plan 34, phase R), bundled with their licence texts beside them (both SIL Open Font
    License 1.1): Inter for text (Regular, Medium, SemiBold, Bold, ExtraBold), JetBrains Mono for figures and code
    (Regular, Bold) and IBM Plex Sans Arabic for Arabic (SemiBold: the splash's name). MauiProgram registers them under
    the aliases Idrak.Maui's styles name.
  -->
  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*.otf;Resources\Fonts\*.ttf" />
    <None Include="Resources\Fonts\OFL-*.txt" />
  </ItemGroup>

  <Target Name="IdrakIconMark" BeforeTargets="ResizetizeCollectItems;ProcessMauiSplashScreens;PrepareForBuild" Inputs="$(IdrakIconSource)" Outputs="$(IdrakIconMark)">
    <PropertyGroup>
      <_IdrakIcon>$([System.IO.File]::ReadAllText('$(IdrakIconSource)'))</_IdrakIcon>
      <_IdrakMark>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakIcon)', '\s*&lt;rect\b[^&gt;]*\brx=[^&gt;]*/&gt;', ''))</_IdrakMark>
    </PropertyGroup>
    <Error Condition="'$(_IdrakMark)' == '$(_IdrakIcon)'" Text="$(IdrakIconSource) has no rounded square (a &lt;rect rx=...&gt;) to take out; the app's icon is made from it." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(IdrakIconMark)'))" />
    <WriteLinesToFile File="$(IdrakIconMark)" Lines="$([MSBuild]::Escape('$(_IdrakMark)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The light splash's picture: the whole icon, its viewBox widened so the icon takes IdrakSplashTileScale of it. -->
  <Target Name="IdrakSplashTile" BeforeTargets="ResizetizeCollectItems;ProcessMauiSplashScreens;PrepareForBuild"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <_IdrakIcon>$([System.IO.File]::ReadAllText('$(IdrakIconSource)'))</_IdrakIcon>
      <_IdrakViewBox>$([System.Text.RegularExpressions.Regex]::Match('$(_IdrakIcon)', '\bviewBox="[^"]*"'))</_IdrakViewBox>
      <_IdrakViewBoxPattern>^\s*viewBox="\s*([-+.\deE]+)[\s,]+([-+.\deE]+)[\s,]+([-+.\deE]+)[\s,]+([-+.\deE]+)\s*"$</_IdrakViewBoxPattern>
      <_IdrakViewBoxValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_IdrakViewBox)', '$(_IdrakViewBoxPattern)'))</_IdrakViewBoxValid>
      <_IdrakSplashTileScaleValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(IdrakSplashTileScale)', '^(0?\.\d*[1-9]\d*|1(\.0*)?)$'))</_IdrakSplashTileScaleValid>
    </PropertyGroup>
    <Error Condition="'$(_IdrakViewBoxValid)' != 'True'" Text="$(IdrakIconSource) has no viewBox of four numbers; the splash's tile is made from it." />
    <Error Condition="'$(_IdrakSplashTileScaleValid)' != 'True'"
           Text="IdrakSplashTileScale is '$(IdrakSplashTileScale)': use a number above 0, at most 1 (the share of the splash picture the tile takes)." />
    <PropertyGroup>
      <_IdrakVbX>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakViewBox)', '$(_IdrakViewBoxPattern)', '$1'))</_IdrakVbX>
      <_IdrakVbY>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakViewBox)', '$(_IdrakViewBoxPattern)', '$2'))</_IdrakVbY>
      <_IdrakVbW>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakViewBox)', '$(_IdrakViewBoxPattern)', '$3'))</_IdrakVbW>
      <_IdrakVbH>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakViewBox)', '$(_IdrakViewBoxPattern)', '$4'))</_IdrakVbH>
      <_IdrakTileW>$([MSBuild]::Divide($(_IdrakVbW), $(IdrakSplashTileScale)))</_IdrakTileW>
      <_IdrakTileH>$([MSBuild]::Divide($(_IdrakVbH), $(IdrakSplashTileScale)))</_IdrakTileH>
      <_IdrakTileX>$([MSBuild]::Subtract($(_IdrakVbX), $([MSBuild]::Divide($([MSBuild]::Subtract($(_IdrakTileW), $(_IdrakVbW))), 2))))</_IdrakTileX>
      <_IdrakTileY>$([MSBuild]::Subtract($(_IdrakVbY), $([MSBuild]::Divide($([MSBuild]::Subtract($(_IdrakTileH), $(_IdrakVbH))), 2))))</_IdrakTileY>
      <_IdrakTile>$([System.Text.RegularExpressions.Regex]::Replace('$(_IdrakIcon)', '\bviewBox="[^"]*"', 'viewBox="$(_IdrakTileX) $(_IdrakTileY) $(_IdrakTileW) $(_IdrakTileH)"'))</_IdrakTile>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(IdrakSplashTile)'))" />
    <WriteLinesToFile File="$(IdrakSplashTile)" Lines="$([MSBuild]::Escape('$(_IdrakTile)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!--
    The night splash on Android: the colour and the two drawables MAUI's splash theme names (maui_splash_color,
    maui_splash_image), under -night, in a resource folder of their own added as MAUI adds its splash's folder; the
    picture is the MauiImage above. Before Android 12 the window's background draws the picture at its size in the
    middle; from Android 12 the system's splash takes the 108dp one as its icon (the adaptive icon's size).
  -->
  <Target Name="IdrakSplashNight" BeforeTargets="_ComputeAndroidResourcePaths"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PropertyGroup>
      <_IdrakSplashNightRes>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'idraksplash'))</_IdrakSplashNightRes>
      <_IdrakSplashNightColors><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<!-- Written by the app's build (IdrakSplashNight, Idrak.Mobile.csproj): the night splash's ground. -->
<resources><color name="maui_splash_color">$(IdrakSplashNightGround)</color></resources>]]></_IdrakSplashNightColors>
      <_IdrakSplashNightImage><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<!-- Written by the app's build (IdrakSplashNight, Idrak.Mobile.csproj): the night splash's mark, before Android 12. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"><item><bitmap android:gravity="center" android:src="@drawable/idrakmark" android:mipMap="true" /></item></layer-list>]]></_IdrakSplashNightImage>
      <_IdrakSplashNightImage31><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<!-- Written by the app's build (IdrakSplashNight, Idrak.Mobile.csproj): the night splash's mark, Android 12 and later. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"><item android:width="108dp" android:height="108dp" android:gravity="center"><bitmap android:gravity="fill" android:src="@drawable/idrakmark" android:mipMap="true" /></item></layer-list>]]></_IdrakSplashNightImage31>
    </PropertyGroup>
    <MakeDir Directories="$(_IdrakSplashNightRes)/values-night;$(_IdrakSplashNightRes)/drawable-night;$(_IdrakSplashNightRes)/drawable-night-v31" />
    <WriteLinesToFile File="$(_IdrakSplashNightRes)/values-night/idrak_splash_colors.xml" Lines="$([MSBuild]::Escape('$(_IdrakSplashNightColors)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_IdrakSplashNightRes)/drawable-night/maui_splash_image.xml" Lines="$([MSBuild]::Escape('$(_IdrakSplashNightImage)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_IdrakSplashNightRes)/drawable-night-v31/maui_splash_image.xml" Lines="$([MSBuild]::Escape('$(_IdrakSplashNightImage31)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_IdrakSplashNightRes).stamp" Lines="$([MSBuild]::Escape('$(_IdrakSplashNightColors)$(_IdrakSplashNightImage)$(_IdrakSplashNightImage31)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <LibraryResourceDirectories Include="$(_IdrakSplashNightRes)">
        <StampFile>$(_IdrakSplashNightRes).stamp</StampFile>
      </LibraryResourceDirectories>
      <FileWrites Include="$(_IdrakSplashNightRes)/**/*;$(_IdrakSplashNightRes).stamp" />
    </ItemGroup>
  </Target>

</Project>
