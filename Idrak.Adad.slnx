<Solution>
  <!-- Adad's own solution: nothing of Idrak builds with it, and Adad references no Idrak project. -->
  <Folder Name="/src/">
    <Project Path="src/Idrak.Adad/Idrak.Adad.csproj" />
    <Project Path="src/Idrak.Adad.Host/Idrak.Adad.Host.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Idrak.Adad.Tests/Idrak.Adad.Tests.csproj" />
  </Folder>
</Solution>
